---
import '../styles/global.css';
import { SITE } from '../site.config';
import { TIPLER, TIP_SIRA, TIP_ACIKLAMA, meta, tipImg, kisaTl, tipUrl } from '../lib/data';
import { KONULAR } from '../lib/konular';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: object[];
  ogType?: string;
  ogImage?: string;
  tip?: string;
  bodyClass?: string;
  preload?: string;
  lang?: string;
  alternates?: { lang: string; href: string }[];
}
const { title, description, noindex = false, jsonLd = [], ogType = 'website', ogImage = '/og.png', tip = '', bodyClass = '', preload = '', lang = 'tr', alternates = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
// Google arama sonucunda kesilmesin: başlık ≤ 62, açıklama ≤ 158 karakter
const kelimeKes = (t: string, n: number, son = '') => (t.length <= n ? t : t.slice(0, t.lastIndexOf(' ', n - son.length)).replace(/[\s,:;–-]+$/, '') + son);
const kisaBaslik = (t: string) => {
  let x = t;
  if (x.length > 62) x = x.replace(/\s*\([^)]*\)/g, '');
  if (x.length > 62) x = x.replace(/\s+(Ocak|Şubat|Mart|Nisan|Mayıs|Haziran|Temmuz|Ağustos|Eylül|Ekim|Kasım|Aralık)\s+(20\d\d)/, ' $2');
  if (x.length > 62) x = x.replace(` | ${SITE.ad}`, '');
  return kelimeKes(x, 62);
};
// Marka adı başlıklarda iki kelime yazılır (“prefabrik teklif” aramaları için)
const fullTitle = kisaBaslik(title.includes(SITE.ad) || title.includes('Prefabrik Teklif') || title.length > 50 ? title : `${title} | Prefabrik Teklif`);
const metaDesc = kelimeKes(description.replace(/\s+/g, ' ').trim(), 158, '…');
const og = new URL(ogImage, SITE.url).href;
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', '@id': `${SITE.url}/#org`, name: 'Prefabrik Teklif', alternateName: ['PrefabrikTeklif', 'prefabrikteklif.com.tr'], url: SITE.url,
  legalName: SITE.sirketUnvani || undefined, logo: new URL('/logo.png', SITE.url).href,
  description: 'Türkiye’deki prefabrik ev, tiny house, çelik ev, konteyner ev, ahşap ev ve bungalov üreticilerinin fiyatlarını karşılaştıran ve firmalardan teklif toplayan platform.',
  ...(SITE.eposta ? { email: SITE.eposta } : {}), ...(SITE.telefon ? { telephone: SITE.telefon } : {}),
  ...(SITE.adres ? { address: { '@type': 'PostalAddress', streetAddress: 'Karakavak Mah. Güngör Cad. No:27K', addressLocality: 'Yeşilyurt', addressRegion: 'Malatya', addressCountry: 'TR' } } : {}),
  ...(SITE.instagram ? { sameAs: [`https://www.instagram.com/${SITE.instagram}/`] } : {}),
};
const COK_ARANAN = ['en-ucuz-prefabrik-ev-fiyatlari', 'anahtar-teslim-prefabrik-ev-fiyatlari', 'tek-katli-prefabrik-ev-fiyatlari', 'dubleks-prefabrik-ev-fiyatlari', 'prefabrik-villa-fiyatlari', 'bahce-evi-fiyatlari'];
const konuIlk = COK_ARANAN.map((sl) => KONULAR.find((k) => k.slug === sl)).filter((k): k is (typeof KONULAR)[number] => !!k);
const konuDiger = KONULAR.filter((k) => !COK_ARANAN.includes(k.slug));
const tipler = TIP_SIRA.filter((k) => TIPLER[k]).map((k) => ({ k, ...TIPLER[k], min: meta.istatistik[k]?.min }));
const populer = [
  { ad: '2+1 prefabrik ev', url: '/prefabrik-ev-fiyatlari/2-1/' },
  { ad: '100 m² prefabrik', url: '/prefabrik-ev-fiyatlari/100-m2/' },
  { ad: 'Tiny house fiyatları', url: '/tiny-house-fiyatlari/' },
  { ad: 'Bağ evi', url: '/bungalov-fiyatlari/' },
  { ad: 'Arazim uygun mu?', url: '/arazim-uygun-mu/' },
];
const ic = {
  kalp: '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>',
  kisi: '<circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  ara: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/>',
  kiyas: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={metaDesc} />
  <link rel="canonical" href={canonical} />
  {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, SITE.url).href} />)}
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
  <meta name="theme-color" content="#17663f" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
  <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM özeti" />
  <link rel="alternate" type="application/rss+xml" href="/rehber/rss.xml" title="PrefabrikTeklif Rehber" />
  {preload && <link rel="preload" as="image" href={preload} fetchpriority="high" />}
  <meta property="og:site_name" content="Prefabrik Teklif" />
  <meta property="og:locale" content="tr_TR" />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  {SITE.googleDogrulama && <meta name="google-site-verification" content={SITE.googleDogrulama} />}
  {SITE.bingDogrulama && <meta name="msvalidate.01" content={SITE.bingDogrulama} />}
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
</head>
<body data-tip={tip || undefined} class={bodyClass || undefined}>
  <a class="skip" href="#icerik">İçeriğe geç</a>
  <div class="topbar">
    <div class="wrap">
      <span><span class="hide-m">{meta.firmaSayisi} firma · </span>{meta.modelSayisi} model · fiyatlar {meta.sonKontrolYazi}’de kontrol edildi</span>
      <nav class="tb-r" aria-label="Firmalar için">
        <a href="/firma-paneli/">Firma girişi</a>
        <a href="/firma-kayit/">Firmanızı ekleyin</a>
        <a href="/reklam-ver/">Reklam ver</a>
      </nav>
    </div>
  </div>
  <header class="hdr">
    <div class="wrap">
      <a class="logo" href="/" title={`${SITE.ad} ana sayfa`}>
        <svg class="lm" width="36" height="35" viewBox="8 6 96 92" aria-hidden="true"><path fill="#17663f" d="M10 38.7 L56 8 L102 38.7 L102 51.7 L56 21 L22 43.7 L22 96 L10 96 Z"/><path fill="#3fae6c" d="M30 57.3 L56 40 L102 70.7 L102 83.7 L56 53 L30 70.3 Z"/></svg>
        <span class="lt"><span>Prefabrik <b>Teklif</b></span><small>Ev karşılaştırma platformu</small></span>
      </a>
      <a class="hsearch" href="/evini-bul/">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" set:html={ic.ara} />
        <span>Hangi evi arıyorsunuz? Tip, m², oda…</span>
        <i aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg></i>
      </a>
      <nav class="hnav" aria-label="Ana menü">
        <div class="mm" id="mm">
          <button type="button" aria-expanded="false" aria-controls="mm-panel">Ev tipleri <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button>
          <div class="mm-panel" id="mm-panel">
            {tipler.map((t) => (
              <a class="t" href={tipUrl(t.k)}>
                <img src={tipImg(t.k, 'kare')} alt="" width="56" height="56" loading="lazy" decoding="async" />
                <span><b>{t.baslik}</b><span>{t.min ? `${kisaTl(t.min)}’den` : TIP_ACIKLAMA[t.k]}</span></span>
              </a>
            ))}
            <div class="pop"><b>Popüler:</b>{populer.map((p) => <a href={p.url}>{p.ad}</a>)}</div>
          </div>
        </div>
        <a class="d-only" href="/firmalar/">Firmalar</a>
        <a class="d-only" href="/rehber/">Rehber</a>
      </nav>
      <div class="hicons">
        <a class="hicon" href="/karsilastir/" aria-label="Karşılaştırma listem"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true" set:html={ic.kiyas} /><span class="cnt" data-cnt="cmp"></span></a>
        <a class="hicon" href="/favorilerim/" aria-label="Favorilerim"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true" set:html={ic.kalp} /><span class="cnt" data-cnt="fav"></span></a>
        <a class="hlogin" href="/giris/" data-hesap aria-label="Giriş yap"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true" set:html={ic.kisi} /><span class="lbl">Giriş yap</span></a>
        <button class="hicon mobile-only" type="button" aria-label="Menüyü aç" data-drawer-open><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={ic.menu} /></button>
      </div>
      <a class="hcta" href="/teklif-al/">Teklif al</a>
    </div>
    <div class="msearch">
      <a class="hsearch" href="/evini-bul/">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" set:html={ic.ara} />
        <span>Hangi evi arıyorsunuz?</span>
        <i aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg></i>
      </a>
    </div>
  </header>
  <div class="drawer" id="drawer" aria-hidden="true">
    <div class="in" role="dialog" aria-modal="true" aria-label="Menü">
      <div class="dhead">
        <a class="logo" href="/"><svg class="lm" width="30" height="29" viewBox="8 6 96 92" aria-hidden="true"><path fill="#17663f" d="M10 38.7 L56 8 L102 38.7 L102 51.7 L56 21 L22 43.7 L22 96 L10 96 Z"/><path fill="#3fae6c" d="M30 57.3 L56 40 L102 70.7 L102 83.7 L56 53 L30 70.3 Z"/></svg><span class="lt"><span>Prefabrik <b>Teklif</b></span></span></a>
        <button class="hicon" type="button" aria-label="Menüyü kapat" data-drawer-close><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      </div>
      <a class="btn btn-p" href="/evini-bul/">Hangi evi arıyorsunuz?</a>
      <div class="tgrid" aria-label="Ev tipleri">
        {tipler.map((t) => <a href={tipUrl(t.k)}><img src={tipImg(t.k, 'kare')} alt="" width="64" height="64" loading="lazy" decoding="async" /><span>{t.ad}</span></a>)}
      </div>
      <nav class="links" aria-label="Mobil menü">
        <p class="dgrup">Teklif</p>
        <div class="dkart">
          <a href="/teklif-al/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4z"/><path d="M4 7l8 6 8-6"/></svg>48 saatte teklif al</a>
          <a href="/teklif-al/?mod=surec"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4L19 6"/></svg>Süreci siz yönetin</a>
          <a href="/arazim-uygun-mu/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6-5.5-6-11a6 6 0 0 1 12 0c0 5.5-6 11-6 11z"/><circle cx="12" cy="10" r="2.2"/></svg>Arazim uygun mu?</a>
          <a href="/prefabrik-ev-maliyet-hesaplama/"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 12h2M14 12h2M8 16h2M14 16h2"/></svg>Maliyet hesaplama</a>
        </div>
        <p class="dgrup">Keşfet</p>
        <div class="dkart">
          <a href="/firmalar/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21V9l9-6 9 6v12"/><path d="M9 21v-6h6v6"/></svg>Firmalar</a>
          <a href="/rehber/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 19V5"/></svg>Rehber</a>
          <a href="/favorilerim/"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ic.kalp} />Favorilerim</a>
          <a href="/karsilastir/"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ic.kiyas} />Karşılaştırma</a>
        </div>
        <p class="dgrup">Hesap</p>
        <div class="dkart">
          <a href="/hesabim/"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ic.kisi} />Hesabım</a>
          <a href="/firma-paneli/"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>Firma girişi</a>
        </div>
        <div class="dalt">
          <a href="/firma-kayit/">Firmanızı ekleyin</a>
          <a href="/reklam-ver/">Reklam ver</a>
        </div>
      </nav>
    </div>
  </div>
  <main id="icerik">
    <slot />
  </main>
  <div class="wrap by-dis">
        <details class="bize-yazin" id="bize-yazin">
          <summary><span class="by-ikon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12a8 8 0 0 1-11.6 7.1L4 20l.9-4.4A8 8 0 1 1 20 12z"/></svg></span><span class="by-m"><b id="by-baslik">Bize yazın</b><span class="small muted">Soru, öneri, şikâyet ya da iş birliği · 1 iş günü içinde dönüyoruz</span></span><span class="by-ac">Mesaj yaz</span></summary>
          <form id="by-form" novalidate>
            <div class="by-uc">
              <label class="f">Adınız<input type="text" name="ad" maxlength="80" required autocomplete="name" /></label>
              <label class="f">E-posta<input type="email" name="eposta" maxlength="120" required autocomplete="email" /></label>
            <label class="f">Konu<select name="konu"><option value="soru">Soru</option><option value="oneri">Öneri</option><option value="sikayet">Şikâyet</option><option value="isbirligi">İş birliği</option><option value="reklam">Reklam</option><option value="diger">Diğer</option></select></label>
            </div>
            <label class="f">Mesajınız<textarea name="mesaj" maxlength="3000" rows="2" required></textarea></label>
            <div class="hp" aria-hidden="true"><label>Web<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
            <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap"><button class="btn btn-p btn-s" type="submit">Gönder</button><span class="xs muted">Bilgileriniz yalnızca size dönüş yapmak için kullanılır. <a href="/kvkk-aydinlatma-metni/">Aydınlatma metni</a></span></div>
            <p class="small" id="by-durum" role="status" hidden></p>
          </form>
        </details>
  </div>
  <footer class="ftr">
    <div class="wrap">
      <div class="cols5">
        <div>
          <a class="logo" href="/"><svg class="lm" width="36" height="35" viewBox="8 6 96 92" aria-hidden="true"><path fill="#17663f" d="M10 38.7 L56 8 L102 38.7 L102 51.7 L56 21 L22 43.7 L22 96 L10 96 Z"/><path fill="#3fae6c" d="M30 57.3 L56 40 L102 70.7 L102 83.7 L56 53 L30 70.3 Z"/></svg><span class="lt"><span>Prefabrik <b>Teklif</b></span><small>Ev karşılaştırma platformu</small></span></a>
          <p style="margin-top:12px">{meta.firmaSayisi} üreticinin {meta.modelSayisi} modeli tek yerde. Fiyatlar firmaların kendi sitelerinden alınır; her fiyatın yanında kaynağı ve son kontrol tarihi yazar.</p>
          <p class="small muted">Satışı üretici firma yapar; {SITE.ad} aracı hizmet sağlayıcıdır.{SITE.eposta && <> · <a href={`mailto:${SITE.eposta}`}>{SITE.eposta}</a></>}</p>
          {SITE.instagram && <p style="margin-top:10px"><a class="sosyal" href={`https://www.instagram.com/${SITE.instagram}/`} rel="me noopener" target="_blank"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg> Instagram’da takip edin: @{SITE.instagram}</a></p>}
        </div>
        <div>
          <h2>Fiyatlar</h2>
          <ul>{tipler.map((t) => <li><a href={tipUrl(t.k)}>{t.baslik}</a></li>)}</ul>
        </div>
        <div>
          <h2>Çok arananlar</h2>
          <ul>{konuIlk.map((k) => <li><a href={`/${k.slug}/`}>{k.baslik}</a></li>)}</ul>
          <details class="ftr-daha"><summary>Tümünü gör ({konuDiger.length})</summary><ul>{konuDiger.map((k) => <li><a href={`/${k.slug}/`}>{k.baslik}</a></li>)}</ul></details>
        </div>
        <div>
          <h2>Rehber ve araçlar</h2>
          <ul>
            <li><a href="/evini-bul/">Hangi evi arıyorsunuz?</a></li>
            <li><a href="/arazim-uygun-mu/">Arazim uygun mu?</a></li>
            <li><a href="/prefabrik-ev-maliyet-hesaplama/">Maliyet hesaplama</a></li>
            <li><a href="/yurt-disindan-prefabrik-ev/">Yurt dışından ev yaptırma</a></li>
            <li><a href="/prefabrik-ev-fiyat-endeksi/">Fiyat endeksi</a></li>
            <li><a href="/rehber/">Tüm rehber yazıları</a></li>
            <li><a href="/firmalar/">Firmalar</a></li>
            <li><a href="/nasil-calisir/">Nasıl çalışır?</a></li>
          </ul>
        </div>
        <div>
          <h2>Kurumsal</h2>
          <ul>
            <li><a href="/firma-kayit/">Firmanızı ekleyin</a></li>
            <li><a href="/firma-paneli/">Firma girişi</a></li>
            <li><a href="/reklam-ver/">Reklam ver</a></li>
            <li><a href="/firma-uyelik-sozlesmesi/">Firma üyelik sözleşmesi</a></li>
            <li><a href="/siralama-nasil-yapilir/">Sıralama nasıl yapılır?</a></li>
            <li><a href="/iletisim/">İletişim</a></li>
          </ul>
        </div>
      </div>
      <p class="site-note">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#17663F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
        <span><b>Küçük bir rica:</b> Lütfen hizmet aldığınız firmayı sözleşmeden önce siz de teyit edin. Firmaları resmi evraklarıyla ve referanslarıyla kabul ediyor, referansı olmayanı kaydetmiyoruz; yine de satış, üretim, teslim ve garanti üretici firmanın sorumluluğundadır, {SITE.ad} aracı platform olarak bu süreçlerden sorumlu tutulamaz. <a href="/kullanim-kosullari/">Ayrıntılar</a></span>
      </p>
      <div class="bot">
        <span>© {new Date().getFullYear()} {SITE.sirketUnvani || SITE.ad} · Web tasarım ve dijital pazarlama: <a href="https://mitraajans.com/">Mitra Ajans</a></span>
        <span><a href="/kvkk-aydinlatma-metni/">KVKK</a> · <a href="/gizlilik-politikasi/">Gizlilik</a> · <a href="/kullanici-sozlesmesi/">Kullanıcı sözleşmesi</a> · <a href="/abonelik-ve-iptal-kosullari/">Abonelik ve iptal</a> · <a href="/surec-yonetimi-hizmet-sozlesmesi/">Hizmet sözleşmesi</a> · <a href="/cerez-politikasi/">Çerezler</a></span>
      </div>
    </div>
  </footer>
  <div class="cbar" id="cbar" role="region" aria-label="Karşılaştırma listesi">
    <span><b><span data-cnt="cmp">0</span> ev seçildi</b><span>5’e kadar ekleyebilirsiniz</span></span>
    <a class="btn btn-s" href="/karsilastir/">Karşılaştır</a>
  </div>

---
import { kisaTl, sayi } from '../lib/data';
interface Props { s: { model: number; fiyatli: number; firma: number; min: number | null; max: number | null; medyan: number | null; m2Medyan: number | null } }
const { s } = Astro.props;
---
<div class="stats">
  <div class="stat"><span>Firma / model</span><strong>{s.firma} / {s.model}</strong></div>
  {s.min && <div class="stat"><span>En düşük</span><strong>{kisaTl(s.min)}</strong></div>}
  {s.medyan && <div class="stat"><span>Ortanca fiyat</span><strong>{kisaTl(s.medyan)}</strong></div>}
  {s.max && <div class="stat"><span>En yüksek</span><strong>{kisaTl(s.max)}</strong></div>}
  {s.m2Medyan && <div class="stat"><span>Ortanca m² fiyatı</span><strong>{sayi(s.m2Medyan)} TL</strong></div>}
</div>

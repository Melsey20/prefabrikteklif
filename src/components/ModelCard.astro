---
import { type Model, fiyatYazi, sayi, modelUrl, firmBySlug, modelImg, etiketler, katYazi, modelId } from '../lib/data';
interface Props { m: Model; firmaGoster?: boolean; eager?: boolean }
const { m, firmaGoster = true, eager = false } = Astro.props;
const f = firmBySlug(m.firma);
const id = modelId(m);
const tags = etiketler(m);
const kat = katYazi(m);
---
<article class="mcard" data-id={id} data-fiyat={m.fiyatTuru === 'model' && m.fiyat ? m.fiyat : ''} data-m2fiyat={m.m2Fiyat ?? ''} data-m2={m.m2 ?? ''}>
  <div class="ph">
    <img src={modelImg(m, 480)} srcset={`${modelImg(m, 480)} 480w, ${modelImg(m, 960)} 960w`} sizes="(max-width: 700px) 92vw, 320px" alt="" width="480" height="300" loading={eager ? 'eager' : 'lazy'} decoding="async" data-foto />
    <span class="tm" data-tm>{m.gorsel ? 'Firmanın sitesinden' : 'Temsili görsel'}</span>
    <button class="fav" type="button" data-id={id} aria-label="Favorilere ekle" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg></button>
  </div>
  <div class="bd">
    {firmaGoster && <span class="fr">{m.firmaAd}{f?.il ? ` · ${f.il}` : ''}</span>}
    <h3><a href={modelUrl(m)}>{m.ad}</a></h3>
    <div class="spec">
      {m.m2 && <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#55615A" stroke-width="2" aria-hidden="true"><path d="M3 3h18v18H3zM3 9h18M9 21V9"/></svg>{sayi(m.m2)} m²</span>}
      {m.oda && <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#55615A" stroke-width="2" aria-hidden="true"><path d="M3 18v-6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v6M3 18h18M6 9V6"/></svg>{m.oda}</span>}
      {kat && <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#55615A" stroke-width="2" aria-hidden="true"><path d="M3 11l9-7 9 7M5 10v10h14V10"/></svg>{kat}</span>}
    </div>
    <ul class="tags" aria-label="Fiyat kapsamı">{tags.map((t) => <li class={t.c}>{t.ad}</li>)}</ul>
    {m.uyari && <p class="warn">{m.uyari}</p>}
    <div class="pr">
      <span><strong data-fiyat-yazi>{fiyatYazi(m)}</strong>{m.m2Fiyat && <span class="m2">{sayi(m.m2Fiyat)} TL / m²</span>}</span>
      <label class="cmp"><input type="checkbox" data-cmp={id} /> Karşılaştır</label>
    </div>
  </div>
</article>

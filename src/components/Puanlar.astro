---
import { SITE } from '../site.config';
interface Props { slug: string; baslik?: string }
const { slug, baslik = 'Puanlar ve yorumlar' } = Astro.props;
---
<section class="box" data-puan={slug} style="display:flex;flex-direction:column;gap:12px">
  <div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><h2 style="margin:0;font-size:1.15rem">{baslik}</h2></div>
  <button class="btn btn-g btn-s" type="button" data-gbtn><svg width="18" height="18" viewBox="0 0 24 24" fill="#E3A008" stroke="#B7800A" stroke-width="1.2" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/></svg>Firmanın Google puanını göster</button>
  <p data-gsonuc hidden style="margin:0"><strong style="font-size:1.4rem" data-gdeger></strong> <span class="muted" data-gsayi></span> <a class="small" data-glink href="#" rel="nofollow noopener" target="_blank" hidden>Google’da aç</a><br><span class="xs muted">Kaynak: Google Haritalar</span></p>
  <p class="small muted" data-gyok hidden style="margin:0">Bu firma için Google puanı bulunamadı.</p>
  <div class="box mint" style="padding:14px;display:flex;gap:12px;align-items:flex-start" data-ybos>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#17663F" stroke-width="2" aria-hidden="true" style="flex:none"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
    <span class="small">Burada yalnızca {SITE.ad} üzerinden bu firmadan <b>gerçekten ev almış</b> kişilerin yorumları yayınlanır; satın alma belgeyle doğrulanır. Henüz yorum yok.</span>
  </div>
  <div data-yliste style="display:flex;flex-direction:column;gap:10px"></div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-puan]').forEach((box) => {
    const slug = box.dataset.puan!;
    const q = <T extends HTMLElement>(s: string) => box.querySelector<T>(s)!;
    const gb = q<HTMLButtonElement>('[data-gbtn]');
    gb.addEventListener('click', async () => {
      gb.disabled = true; gb.textContent = 'Yükleniyor…';
      try {
        const r = await fetch('/api/google-puan?firma=' + encodeURIComponent(slug)); const d = r.ok ? await r.json() : null;
        gb.remove();
        if (!d?.rating) { q('[data-gyok]').hidden = false; return; }
        q('[data-gdeger]').textContent = String(d.rating).replace('.', ',') + ' / 5';
        q('[data-gsayi]').textContent = d.count ? `(${d.count} değerlendirme)` : '';
        if (d.url) { const l = q<HTMLAnchorElement>('[data-glink]'); l.href = d.url; l.hidden = false; }
        q('[data-gsonuc]').hidden = false;
      } catch { gb.remove(); q('[data-gyok]').hidden = false; }
    });
    fetch('/api/yorumlar?firma=' + encodeURIComponent(slug)).then((r) => (r.ok ? r.json() : null)).then((d) => {
      if (!d?.yorumlar?.length) return;
      q('[data-ybos]').remove();
      const box2 = q('[data-yliste]');
      for (const y of d.yorumlar) {
        const el = document.createElement('div'); el.className = 'item';
        const b = document.createElement('strong'); b.textContent = `${y.puan ? y.puan + '/5 · ' : ''}${y.ad || 'Doğrulanmış alıcı'}`;
        const p = document.createElement('p'); p.style.margin = '0'; p.textContent = y.metin;
        el.append(b, p);
        if (y.cevap) { const c = document.createElement('p'); c.className = 'small muted'; c.style.margin = '0'; c.textContent = 'Firma cevabı: ' + y.cevap; el.append(c); }
        box2.append(el);
      }
    }).catch(() => {});
  });
</script>

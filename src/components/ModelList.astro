---
import type { Model } from '../lib/data';
import ModelCard from './ModelCard.astro';
interface Props { list: Model[]; firmaGoster?: boolean; id?: string }
const { list, firmaGoster = true, id = 'liste' } = Astro.props;
---
<h2 class="sr-only">Modeller ve fiyatlar</h2>
<div class="toolbar">
  <span class="small muted">{list.length} model · ucuzdan pahalıya · firmalar sıralama için ücret ödemez</span>
  <label>Sırala
    <select data-sort={id} aria-label="Sıralama">
      <option value="fiyat">Fiyat (düşükten)</option>
      <option value="fiyat-desc">Fiyat (yüksekten)</option>
      <option value="m2fiyat">m² fiyatı</option>
      <option value="m2">Metrekare</option>
    </select>
  </label>
</div>
<div class="grid" id={id} data-katalog>
  {list.map((m, i) => <ModelCard m={m} firmaGoster={firmaGoster} eager={i < 2} />)}
</div>
<script>
  import { katalogUygula } from '../scripts/katalog';
  document.querySelectorAll<HTMLSelectElement>('select[data-sort]').forEach((sel) => {
    const box = document.getElementById(sel.dataset.sort!); if (!box) return;
    sel.addEventListener('change', () => {
      let k = sel.value; const desc = k === 'fiyat-desc'; if (desc) k = 'fiyat';
      const items = [...box.children] as HTMLElement[];
      items.sort((a, b) => {
        const x = parseFloat(a.dataset[k]!) || (desc ? -1 : 1e15), y = parseFloat(b.dataset[k]!) || (desc ? -1 : 1e15);
        return desc ? y - x : x - y;
      });
      items.forEach((i) => box.appendChild(i));
    });
  });
  katalogUygula();
</script>

---
interface Props { items: { s: string; c: string }[]; baslik?: string }
const { items, baslik = 'Sık sorulan sorular' } = Astro.props;
const ld = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: items.map((x) => ({ '@type': 'Question', name: x.s, acceptedAnswer: { '@type': 'Answer', text: x.c } })),
};
---
<section class="faq">
  <h2>{baslik}</h2>
  {items.map((x) => <details><summary>{x.s}</summary><p>{x.c}</p></details>)}
</section>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />

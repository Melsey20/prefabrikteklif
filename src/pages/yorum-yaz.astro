---
import Base from '../layouts/Base.astro';
import { firms } from '../lib/data';
const basliklar = [['fiyat', 'Fiyatına sadık kaldı mı?'], ['teslim', 'Teslim süresi'], ['iscilik', 'İşçilik'], ['satisSonrasi', 'Satış sonrası']];
---
<Base title="Firma hakkında yorum yaz" description="Prefabrik ev firması hakkındaki deneyiminizi paylaşın; satın alıp almadığınız yorumunuzda belirtilir." noindex>
  <div class="wrap narrow sec">
    <h1>Firma hakkında yorum yaz</h1>
    <p class="muted">Deneyiminiz ev arayan başkalarına yol gösterir. Yorumunuzda bu firmadan ev satın alıp almadığınız gösterilir; yorumlar yayından önce kontrol edilir. Olumsuz yorumlar kurallara uygunsa kaldırılmaz.</p>
    <div class="box mint" id="giris-gerek" hidden style="display:flex;flex-direction:column;gap:10px">
      <b>Yorum yazmak için giriş yapın</b>
      <span class="small">Ücretsiz üyelikle 1 dakikada yorum yazabilirsiniz. Google hesabınızla da girebilirsiniz.</span>
      <a class="btn btn-p" id="giris-link" href="/giris/" style="align-self:flex-start">Giriş yap / üye ol</a>
    </div>
    <form class="form" id="y" novalidate hidden>
      <label class="f">Firma
        <select name="firma" required><option value="">Seçin</option>{[...firms].sort((a, b) => a.kisaAd.localeCompare(b.kisaAd, 'tr')).map((f) => <option value={f.slug}>{f.kisaAd}</option>)}</select>
      </label>
      <fieldset><legend>Bu firmadan ev satın aldınız mı?</legend>
        <label class="opt"><input type="radio" name="satinAldi" value="evet" /> Evet, sözleşme yaptım / evim teslim edildi</label>
        <label class="opt"><input type="radio" name="satinAldi" value="hayir" /> Hayır, görüştüm veya teklif aldım</label>
      </fieldset>
      <fieldset data-alici hidden><legend>Aşama</legend>
        <label class="opt"><input type="radio" name="asama" value="sozlesme" checked /> Sözleşme yaptım, ev henüz teslim edilmedi</label>
        <label class="opt"><input type="radio" name="asama" value="teslim" /> Ev teslim edildi</label>
      </fieldset>
      <label class="f">Genel puanınız
        <select name="puan" required><option value="">Puan verin</option><option value="5">5 · Çok iyi</option><option value="4">4 · İyi</option><option value="3">3 · Orta</option><option value="2">2 · Kötü</option><option value="1">1 · Çok kötü</option></select>
      </label>
      <div class="two" data-alici hidden>
        {basliklar.map(([k, ad]) => (
          <label class="f">{ad}
            <select name={k}><option value="">Puan verin (isteğe bağlı)</option><option value="5">5</option><option value="4">4</option><option value="3">3</option><option value="2">2</option><option value="1">1</option></select>
          </label>
        ))}
      </div>
      <label class="f">Yorumunuz<textarea name="metin" minlength="30" maxlength="2000" required placeholder="Fiyat, iletişim, teslim süresi, işçilik… Neler yaşadınız?"></textarea></label>
      <label class="f" data-alici hidden>Belge (isteğe bağlı: sözleşme veya fatura tarihi; belgeyi e-postayla isteyebiliriz, doğrulanırsa yorumunuzda “belgeyle doğrulandı” yazar)<input type="text" name="belge" maxlength="300" /></label>
      <label class="f">Yorumda görünecek adınız<input type="text" name="ad" maxlength="60" placeholder="Ör. Ayşe Y." /></label>
      <p class="err" id="hata" role="alert" hidden></p>
      <button class="btn btn-p btn-block" type="submit">Yorumu gönder</button>
    </form>
    <div class="ok" id="tamam" hidden><h2 style="margin-top:0">Teşekkürler</h2><p>Yorumunuz kontrol edildikten sonra firma sayfasında yayınlanacak.</p><a class="btn btn-g" id="firmaya-don" href="/firmalar/">Firma sayfasına dön</a></div>
  </div>
  <script>
    import { kullanici, api, dogrulamaGonder } from '../scripts/fb';
    const $ = (id: string) => document.getElementById(id)!;
    const f = $('y') as HTMLFormElement, h = $('hata');
    const q = new URLSearchParams(location.search);
    const t = q.get('t');
    const sec = f.elements.namedItem('firma') as HTMLSelectElement;
    if (q.get('firma')) sec.value = q.get('firma')!;
    const alici = () => (f.querySelector<HTMLInputElement>('input[name=satinAldi]:checked')?.value === 'evet');
    f.addEventListener('change', () => f.querySelectorAll<HTMLElement>('[data-alici]').forEach((e) => (e.hidden = !alici())));
    const hataYaz = (m: string) => { h.textContent = m; h.hidden = false; };
    (async () => {
      if (t) { f.hidden = false; return; } // teklif özeti e-postasındaki bağlantı
      const u = await kullanici().catch(() => null);
      if (!u) { ($('giris-link') as HTMLAnchorElement).href = '/giris/?geri=' + encodeURIComponent(location.pathname + location.search); $('giris-gerek').hidden = false; return; }
      f.hidden = false;
      const adI = f.elements.namedItem('ad') as HTMLInputElement;
      if (u.displayName) { const p = u.displayName.split(/\s+/); adI.value = p[0] + (p[1] ? ' ' + p[1][0] + '.' : ''); }
      if (!u.emailVerified) {
        hataYaz('Yorum gönderebilmek için e-posta adresinizi doğrulamanız gerekiyor. Doğrulama bağlantısı için tıklayın.');
        h.style.cursor = 'pointer'; h.onclick = async () => { await dogrulamaGonder(); hataYaz('Doğrulama e-postası gönderildi; bağlantıya tıkladıktan sonra bu sayfayı yenileyin.'); };
      }
    })();
    f.addEventListener('submit', async (e) => {
      e.preventDefault(); h.hidden = true;
      const d: any = Object.fromEntries(new FormData(f));
      if (!d.firma) return hataYaz('Yorum yapacağınız firmayı seçin.');
      if (!d.satinAldi && !t) return hataYaz('Bu firmadan ev satın alıp almadığınızı seçin.');
      if (!d.puan) return hataYaz('Genel puanınızı seçin.');
      if ((d.metin || '').trim().length < 30) return hataYaz('Yorumunuz en az 30 karakter olmalı.');
      const btn = f.querySelector('button[type=submit]') as HTMLButtonElement; btn.disabled = true;
      try {
        if (t) { d.t = t; for (const k of ['fiyat', 'teslim', 'iscilik', 'satisSonrasi']) d[k] = d[k] || d.puan; }
        await api('/api/yorum', d);
        f.hidden = true; $('tamam').hidden = false;
        ($('firmaya-don') as HTMLAnchorElement).href = `/firma/${d.firma}/`;
      } catch (err: any) { hataYaz(err.message); } finally { btn.disabled = false; }
    });
  </script>
</Base>

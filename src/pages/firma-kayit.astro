---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import { SITE } from '../site.config';
import { TIPLER, TIP_KEYS, firms, ILLER } from '../lib/data';
---
<Base title="Firma Kaydı: Prefabrik ve Modüler Ev Üreticileri" description={`Prefabrik, çelik, konteyner, tiny house ve ahşap ev üreticileri için aylık ${SITE.abonelik} TL firma üyeliği. Fiyatlarınızı güncelleyin, size uygun teklif taleplerini alın. ${SITE.ad}.`}>
  <div class="wrap narrow">
    <Crumbs items={[{ ad: 'Firma kaydı' }]} />
    <h1>Üreticiyseniz, müşteri talepleri size gelsin</h1>
    <p class="muted">Sadece ilinize ve ürettiğiniz ev tipine uyan talepler gelir; müşteri bilgisi, fiyat vermeyi kabul ettiğinizde açılır.</p>
    <div class="box mint" id="davet-bilgi" hidden style="margin:14px 0;display:flex;gap:12px;align-items:flex-start">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#17663F" stroke-width="2" aria-hidden="true" style="flex:none"><path d="M4 6h16v12H4z"/><path d="M4 7l8 6 8-6"/></svg>
      <span class="small"><b>Sizi bekleyen bir müşteri talebi var.</b> Kaydınızı tamamlayın; başvurunuz onaylanıp aylık üyelik ödemesi yapıldığında bu talep firma panelinizdeki “Teklif bekleyenler” bölümünde fiyat vermeye açılır.</span>
    </div>
    <div class="card" style="margin:16px 0;display:flex;gap:14px;align-items:center;flex-wrap:wrap;background:var(--green-ll);border-color:#cfe4d6">
      <div style="flex:1;min-width:220px"><strong style="font-size:1.05rem">Firma üyeliği: aylık {SITE.abonelik} TL</strong><span class="small muted" style="display:block;margin-top:4px">Başvurunuzu inceleyip onaylarız, ödeme bağlantısını e-postanıza göndeririz. Ödemeyi her ay düzenli yaparsınız; sitede kart bilgisi istemeyiz. Reklam paketleri isteğe bağlıdır ve üyeliğe ektir: <a href="/reklam-ver/">fiyatlar</a>.</span></div>
    </div>
    <p class="small muted">Sitemizdeki her firmayı resmi evraklarıyla ve teslim ettiği işlerin referanslarıyla kabul ediyoruz; referansı olmayan firmayı kaydetmiyoruz. Ev arayanların bize güvenmesinin sebebi bu 🙂</p>

    <div class="grid" style="margin:18px 0">
      <div class="card"><strong>Listelenmiş</strong><span class="small muted">Fiyatlarınız bilgi amaçlı sitenizden alınır; teklif talebi gelmez. Üyelik başlatılmazsa sayfanız ay sonunda sitemizden kaldırılır.</span></div>
      <div class="card"><strong>Kayıtlı firma</strong><span class="small muted">Aylık {SITE.abonelik} TL. Vergi levhası, sicil kaydı, imza sirküleri ve referanslar kontrol edilir. Firma panelinden ürün, fiyat ve fotoğraflarınızı yönetir, size uygun talepleri alır, bize geri bildirim gönderirsiniz.</span></div>
      <div class="card" style="border:1.5px solid var(--green)"><strong style="color:var(--green-d)">Doğrulanmış üretici</strong><span class="small muted">Fabrika ziyareti ve tanıtım videosu, üretim belgeleri ve teslim edilmiş 3 proje kontrol edilir. Taleplerde öncelik ve rozet.</span></div>
    </div>

    <form class="form" id="kayit" novalidate>
      <label class="f">Ticaret unvanı<input type="text" name="unvan" required maxlength="160" /></label>
      <div class="two">
        <label class="f">Marka adı<input type="text" name="marka" maxlength="80" /></label>
        <label class="f">Vergi numarası<input type="text" name="vergiNo" inputmode="numeric" required maxlength="11" /></label>
      </div>
      <label class="f">Listede kayıtlı firmanız varsa seçin
        <select name="mevcut"><option value="">Listede yok / yeni kayıt</option>{[...firms].sort((a, b) => a.kisaAd.localeCompare(b.kisaAd, 'tr')).map((f) => <option value={f.slug}>{f.kisaAd}</option>)}</select>
      </label>
      <label class="f">Fabrika adresi<input type="text" name="adres" required maxlength="240" /></label>
      <div class="two">
        <label class="f">Web sitesi<input type="text" name="web" maxlength="160" placeholder="https://" /></label>
        <label class="f">Yetkili ad soyad<input type="text" name="yetkili" required maxlength="80" /></label>
      </div>
      <div class="two">
        <label class="f">Yetkili cep telefonu<input type="tel" name="telefon" required maxlength="20" /></label>
        <label class="f">E-posta (talepler buraya gelir)<input type="email" name="eposta" required maxlength="120" /></label>
      </div>
      <fieldset>
        <legend>Ürettiğiniz tipler</legend>
        <div class="two">{TIP_KEYS.map((k) => <label class="chk"><input type="checkbox" name="tipler" value={k} /> {TIPLER[k].ad}</label>)}</div>
      </fieldset>
      <fieldset>
        <legend>Hangi illere hizmet veriyorsunuz?</legend>
        <div style="display:flex;gap:18px;flex-wrap:wrap">
          <label class="chk"><input type="radio" name="kapsam" value="tum" checked /> Tüm Türkiye</label>
          <label class="chk"><input type="radio" name="kapsam" value="secili" /> Belirli iller</label>
        </div>
        <div id="il-sec" hidden style="margin-top:10px">
          <input type="search" id="il-ara" placeholder="İl ara (ör. Malatya)" aria-label="İl ara" style="margin-bottom:10px" />
          <div class="il-grid">{ILLER.map((il) => <label class="chk"><input type="checkbox" name="il" value={il} /> {il}</label>)}</div>
          <span class="xs muted" id="il-say">Henüz il seçilmedi. Talepler yalnızca seçtiğiniz illerden gelir.</span>
        </div>
      </fieldset>
      <label class="f">Belgeleriniz (TSE, ISO, CE, O2 tip onay vb.)<input type="text" name="belgeler" maxlength="300" /></label>
      <label class="f">Referanslarınız (zorunlu)<textarea name="referanslar" required maxlength="1500" placeholder="Teslim ettiğiniz en az 1–3 iş: il, yıl, ev tipi ve teyit için müşteri ya da yüklenici iletişim bilgisi"></textarea></label>
      <label class="f">Not<textarea name="not" maxlength="1000"></textarea></label>
      <div class="hp" aria-hidden="true"><label>Web<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
      <label class="chk"><input type="checkbox" name="abonelik" required /> <span>Aylık <b>{SITE.abonelik} TL</b> üyelik bedelini, onaydan sonra gönderilecek bağlantıdan her ay düzenli ödeyeceğimi; ödenen üyelik ve reklam bedellerinin iade edilmediğini biliyorum.</span></label>
      <label class="chk"><input type="checkbox" name="sozlesme" required /> <span><a href="/firma-uyelik-sozlesmesi/" target="_blank">Firma üyelik sözleşmesini</a> okudum ve kabul ediyorum. Müşteriye karşı tüm sorumluluğun firmamda olduğunu, müşteriyi mağdur etmem halinde kaydımın silineceğini biliyorum.</span></label>
      <label class="chk"><input type="checkbox" name="kosul" required /> <span><a href="/kullanim-kosullari/" target="_blank">Kullanım koşullarını</a> ve <a href="/kvkk-aydinlatma-metni/" target="_blank">aydınlatma metnini</a> okudum. Belgelerimi e-postayla göndereceğimi biliyorum.</span></label>
      <p class="err" id="hata" role="alert" hidden></p>
      <button class="btn btn-p btn-block" type="submit" id="gonder">Kaydı gönder</button>
    </form>
    <div class="ok" id="tamam" hidden>
      <h2 style="margin-top:0">Teşekkürler, başvurunuz alındı</h2>
      <p>Belgelerinizi ve referanslarınızı kontrol edip 2 iş günü içinde sizi arayacağız.</p>
      <ol style="margin:8px 0 0;padding-left:20px;line-height:1.7">
        <li>Başvurunuz onaylanınca <b>aylık {SITE.abonelik} TL</b> üyelik ödeme bağlantısı e-postanıza gelir.</li>
        <li>Ödemeyi yaptığınızda firmanız sitede <b>“doğrulanmış”</b> olarak görünür.</li>
        <li>Size uyan taleplere <a href="/firma-paneli/">firma panelinizden</a> fiyat verirsiniz; fiyat verdiğiniz müşterinin iletişim bilgileri size açılır.</li>
      </ol>
      <p class="small muted" style="margin:10px 0 0">Firma paneline başvuruda yazdığınız e-posta adresiyle (Google ile ya da şifre belirleyerek) giriş yapabilirsiniz.</p>
    </div>
  </div>
  <script is:inline>
    (function () {
      var f = document.getElementById('kayit'), q = new URLSearchParams(location.search);
      if (q.get('firma')) f.mevcut.value = q.get('firma');
      var davet = q.get('davet') || ''; if (davet) document.getElementById('davet-bilgi').hidden = false;
      var sec = document.getElementById('il-sec'), say = document.getElementById('il-say');
      f.querySelectorAll('input[name=kapsam]').forEach(function (r) { r.addEventListener('change', function () { sec.hidden = f.kapsam.value !== 'secili'; }); });
      f.addEventListener('change', function (e) { if (e.target.name !== 'il') return; var n = f.querySelectorAll('input[name=il]:checked'); say.textContent = n.length ? n.length + ' il seçildi: ' + [].map.call(n, function (x) { return x.value; }).join(', ') : 'Henüz il seçilmedi. Talepler yalnızca seçtiğiniz illerden gelir.'; });
      document.getElementById('il-ara').addEventListener('input', function (e) { var q = e.target.value.toLocaleLowerCase('tr'); f.querySelectorAll('.il-grid label').forEach(function (l) { l.hidden = q && l.textContent.toLocaleLowerCase('tr').indexOf(q) < 0; }); });
      f.addEventListener('submit', function (e) {
        e.preventDefault(); var h = document.getElementById('hata'); h.hidden = true;
        var d = { tipler: [] }, il = []; new FormData(f).forEach(function (v, k) { if (k === 'tipler') d.tipler.push(v); else if (k === 'il') il.push(v); else d[k] = v; });
        d.iller = d.kapsam === 'secili' ? il.join(', ') : 'Tüm Türkiye'; delete d.kapsam;
        var m = !d.unvan ? 'Ticaret unvanı yazın.' : !/^\d{10,11}$/.test(d.vergiNo || '') ? 'Vergi numarası 10 veya 11 haneli olmalı.' : !d.yetkili ? 'Yetkili adı yazın.' : !/^\S+@\S+\.\S+$/.test(d.eposta || '') ? 'Geçerli e-posta yazın.' : (d.telefon || '').replace(/\D/g, '').length < 10 ? 'Geçerli telefon yazın.' : !d.tipler.length ? 'En az bir ürün tipi seçin.' : !d.iller ? 'Hizmet verdiğiniz illeri seçin ya da Tüm Türkiye’yi işaretleyin.' : (d.referanslar || '').trim().length < 10 ? 'En az bir referans yazın; referanssız kayıt almıyoruz.' : !d.abonelik ? 'Aylık üyelik bedelini onaylayın.' : !d.sozlesme ? 'Firma üyelik sözleşmesini onaylayın.' : !d.kosul ? 'Koşulları onaylayın.' : '';
        if (davet) d.davet = davet;
        d.abonelikOnay = !!d.abonelik; d.sozlesmeOnay = !!d.sozlesme; delete d.abonelik; delete d.sozlesme;
        if (m) { h.textContent = m; h.hidden = false; return; }
        var b = document.getElementById('gonder'); b.disabled = true; b.textContent = 'Gönderiliyor…';
        fetch('/api/firma-basvuru', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(d) })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (res) { if (!res.ok) throw new Error(res.j.hata || 'Gönderilemedi.'); f.hidden = true; document.getElementById('tamam').hidden = false; })
          .catch(function (er) { h.textContent = er.message; h.hidden = false; b.disabled = false; b.textContent = 'Kaydı gönder'; });
      });
    })();
  </script>
</Base>

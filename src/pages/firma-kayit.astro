---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import { SITE } from '../site.config';
import { TIPLER, TIP_KEYS, firms, ILLER } from '../lib/data';
const tl = (n: number) => new Intl.NumberFormat('tr-TR').format(n) + ' TL';
const firmaOzet = Object.fromEntries(firms.map((f) => [f.slug, { u: f.ad, m: f.kisaAd, w: f.web || '', i: f.il || '', t: f.tipler }]));
---
<Base title="Firma Kaydı: Prefabrik ve Modüler Ev Üreticileri" description={`Prefabrik, çelik, konteyner, tiny house ve ahşap ev üreticileri için firma üyeliği${SITE.kampanya.aktif ? ` (ilk ${SITE.kampanya.kontenjan} firmaya 1 ay ücretsiz)` : ''}: ev arayan müşterilerin talepleri tüm detaylarıyla panelinizde, komisyon yok. Fiyatlarınızı güncelleyin, size uygun teklif taleplerini alın. ${SITE.ad}.`}>
  <div class="wrap narrow">
    <Crumbs items={[{ ad: 'Firma kaydı' }]} />
    <h1>Üreticiyseniz, müşteri talepleri size gelsin</h1>
    <p class="muted">Sadece ilinize ve ürettiğiniz ev tipine uyan talepler gelir; müşteri bilgisi, fiyat vermeyi kabul ettiğinizde açılır.</p>
    <div class="box mint" id="davet-bilgi" hidden style="margin:14px 0;display:flex;gap:12px;align-items:flex-start">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#17663F" stroke-width="2" aria-hidden="true" style="flex:none"><path d="M4 6h16v12H4z"/><path d="M4 7l8 6 8-6"/></svg>
      <span class="small"><b>Sizi bekleyen bir müşteri talebi var.</b> Kaydınızı tamamlayın; başvurunuz onaylanıp üyeliğiniz açıldığında bu talep firma panelinizdeki “Teklif bekleyenler” bölümünde fiyat vermeye açılır.</span>
    </div>
    <div class="card" id="kampanya-kutu" hidden={!SITE.kampanya.aktif} style="margin:16px 0 0;border:2px solid var(--green);display:flex;flex-direction:column;gap:10px">
      <strong style="font-size:1.15rem;color:var(--green-d)">Açılış kampanyası: 1 ay ücretsiz üyelik</strong>
      <span class="small">Türkiye’de Google’da her ay <b>150 binden fazla</b> “prefabrik ev” ve “prefabrik ev fiyatları” araması yapılıyor; çelik ev, konteyner ev ve tiny house aramalarıyla bu sayı daha da büyüyor <span class="xs muted">(Semrush, Kasım 2026)</span>. Ev arayanlar burada fiyatları karşılaştırıp teklif istiyor.</span>
      <ul class="small" style="margin:0;padding-left:18px;display:grid;gap:4px">
        <li><b>Müşteri tüm detaylarıyla panelinizde:</b> ili, ev tipi, metrekare ve oda sayısı, bütçesi, arsa durumu ve ne zaman başlamak istediği; fiyat verdiğiniz anda adı, telefonu ve e-postası.</li>
        <li><b>Sadece size uyan talepler:</b> hizmet verdiğiniz iller ve ürettiğiniz ev tipleri.</li>
        <li><b>Komisyon yok:</b> satışınızdan pay almıyoruz.</li>
        <li><b>İlk 50 firmaya 1 ay ücretsiz,</b> kart bilgisi istemeden. Başvurunuz onaylanınca hemen teklif verirsiniz; sonra aylık {SITE.abonelik} TL, devam etmezseniz hiçbir şey ödemezsiniz.</li>
      </ul>
    </div>
    <div class="card" style="margin:16px 0;display:flex;gap:14px;align-items:center;flex-wrap:wrap;background:var(--green-ll);border-color:#cfe4d6">
      <div style="flex:1;min-width:220px"><strong style="font-size:1.05rem">{SITE.kampanya.aktif ? `Üyelik: 1 ay ücretsiz, sonra aylık ${SITE.abonelik} TL` : `Firma üyeliği: aylık ${SITE.abonelik} TL`}</strong><span class="small muted" style="display:block;margin-top:4px">{SITE.kampanya.aktif ? "Başvurunuzu inceleyip onaylarız; üyeliğiniz ödeme yapmadan açılır ve hemen teklif verirsiniz. Ücretsiz ay bitmeden size hatırlatırız; devam ederseniz ödemeyi e-postanıza gelen bağlantıdan yaparsınız. Komisyon ve taahhüt yok." : "Başvurunuzu inceleyip onaylarız, ödeme bağlantısını e-postanıza göndeririz. Ödemeyi her ay düzenli yaparsınız; komisyon ve taahhüt yok."} Reklam paketleri isteğe bağlıdır ve üyeliğe ektir: <a href="/reklam-ver/">fiyatlar</a>.</span></div>
    </div>
    <p class="small muted">Kayıt birkaç dakika sürer: firma ve yetkili bilgileri, ürettiğiniz ev tipleri ve vergi levhanızın fotoğrafı yeterli. Belgeyi telefondan çekip yükleyebilirsiniz.</p>

    <div class="grid" style="margin:18px 0">
      <div class="card"><strong>Listelenmiş</strong><span class="small muted">Fiyatlarınız bilgi amaçlı sitenizden alınır; teklif talebi gelmez. Üyelik başlatılmazsa sayfanız ay sonunda sitemizden kaldırılır.</span></div>
      <div class="card"><strong>Üye firma</strong><span class="small muted">{SITE.kampanya.aktif ? `İlk ay ücretsiz, sonra aylık ${SITE.abonelik} TL.` : `Aylık ${SITE.abonelik} TL.`} Vergi levhası kontrol edilir. Firma panelinden ürün, fiyat ve fotoğraflarınızı yönetir, size uygun talepleri alır, bize geri bildirim gönderirsiniz.</span></div>
      <div class="card" style="border:1.5px solid var(--green)"><strong style="color:var(--green-d)">Doğrulanmış üretici</strong><span class="small muted">Fabrika ziyareti ve tanıtım videosu, üretim belgeleri ve teslim edilmiş 3 proje kontrol edilir. Taleplerde öncelik ve rozet.</span></div>
    </div>

    <div class="kf-ilerleme" id="kf-ilerleme" aria-live="polite"><div class="kf-bar"><span id="kf-dolu"></span></div><span class="small" id="kf-yazi">Zorunlu alanlar: 0 / 0</span></div>
    <p class="small box mint" id="kf-taslak" hidden style="margin:0 0 12px;padding:10px 12px">Kaldığınız yerden devam ediyorsunuz; daha önce yazdıklarınız bu cihazda saklandı. <button type="button" class="lnk" id="kf-temizle">Formu temizle</button></p>
    <script type="application/json" id="firma-ozet" set:html={JSON.stringify(firmaOzet)} />
    <form class="form" id="kayit" novalidate>
      <h2 class="kf-b">1. Firma bilgileri</h2>
      <label class="f">Ticaret unvanı (vergi levhasındaki gibi) *<input type="text" name="unvan" required maxlength="160" autocomplete="organization" /></label>
      <div class="two">
        <label class="f">Marka adı<input type="text" name="marka" maxlength="80" /></label>
        <label class="f">Vergi dairesi<input type="text" name="vergiDairesi" maxlength="80" /></label>
      </div>
      <div class="two">
        <label class="f">Vergi / TC kimlik numarası *<input type="text" name="vergiNo" inputmode="numeric" required maxlength="11" pattern="\d{10,11}" /></label>
        <label class="f">Firmanın bulunduğu il *<select name="merkezIl" required><option value="">Seçin</option>{ILLER.map((il) => <option>{il}</option>)}</select></label>
      </div>
      <label class="f">Listede kayıtlı firmanız varsa seçin
        <select name="mevcut" data-ara><option value="">Listede yok / yeni kayıt</option>{[...firms].sort((a, b) => a.kisaAd.localeCompare(b.kisaAd, 'tr')).map((f) => <option value={f.slug}>{f.kisaAd}</option>)}</select>
      </label>
      <label class="f">Fabrika / merkez adresi<input type="text" name="adres" maxlength="240" autocomplete="street-address" /></label>
      <label class="f">Web sitesi<input type="url" name="web" maxlength="160" placeholder="https://" /></label>
      <h2 class="kf-b">2. Yetkili</h2>
      <div class="two">
        <label class="f">Yetkili ad soyad *<input type="text" name="yetkili" required maxlength="80" autocomplete="name" /></label>
        <label class="f">Görevi<input type="text" name="yetkiliUnvan" maxlength="60" placeholder="Ör. Satış müdürü" /></label>
      </div>
      <div class="two">
        <label class="f">Yetkili cep telefonu *<input type="tel" name="telefon" required maxlength="20" autocomplete="tel" /></label>
        <label class="f">E-posta (talepler ve panel girişi) *<input type="email" name="eposta" required maxlength="120" autocomplete="email" /></label>
      </div>
      <h2 class="kf-b">3. Vergi levhası</h2>
      <p class="small muted" style="margin:-4px 0 0">PDF, PNG, JPEG ya da HEIC; dosya başına en fazla 10 MB. Belgeleriniz yalnızca doğrulama için ekibimizce görülür, sitede yayınlanmaz.</p>
      <div class="evrak" id="evrak">
        <div class="ev-s" data-tur="vergi-levhasi"><span><b>Vergi levhası *</b><small>Güncel yıla ait</small></span><label class="btn btn-g btn-s">Dosya seç<input type="file" accept=".pdf,.png,.jpg,.jpeg,.heic,.heif,application/pdf,image/png,image/jpeg,image/heic,image/heif" hidden /></label><em></em></div>
        <div class="ev-s" data-tur="faaliyet"><span><b>Faaliyet belgesi</b><small>İsteğe bağlı</small></span><label class="btn btn-g btn-s">Dosya seç<input type="file" accept=".pdf,.png,.jpg,.jpeg,.heic,.heif,application/pdf,image/png,image/jpeg,image/heic,image/heif" hidden /></label><em></em></div>
        <div class="ev-s" data-tur="sicil-gazetesi"><span><b>Ticaret Sicil Gazetesi</b><small>İsteğe bağlı</small></span><label class="btn btn-g btn-s">Dosya seç<input type="file" accept=".pdf,.png,.jpg,.jpeg,.heic,.heif,application/pdf,image/png,image/jpeg,image/heic,image/heif" hidden /></label><em></em></div>
        <div class="ev-s" data-tur="imza-sirkuleri"><span><b>İmza sirküleri</b><small>İsteğe bağlı</small></span><label class="btn btn-g btn-s">Dosya seç<input type="file" accept=".pdf,.png,.jpg,.jpeg,.heic,.heif,application/pdf,image/png,image/jpeg,image/heic,image/heif" hidden /></label><em></em></div>
        <div class="ev-s" data-tur="diger"><span><b>Diğer (TSE, ISO, CE, O2 vb.)</b><small>İsteğe bağlı</small></span><label class="btn btn-g btn-s">Dosya seç<input type="file" accept=".pdf,.png,.jpg,.jpeg,.heic,.heif,application/pdf,image/png,image/jpeg,image/heic,image/heif" hidden /></label><em></em></div>
      </div>
      <h2 class="kf-b">4. Ürünler ve hizmet bölgesi</h2>
      <fieldset>
        <legend>Ürettiğiniz tipler</legend>
        <div class="two">{TIP_KEYS.map((k) => <label class="chk"><input type="checkbox" name="tipler" value={k} /> {TIPLER[k].ad}</label>)}<label class="chk"><input type="checkbox" name="tipler" value="agir-celik" /> Ağır çelik yapı (fabrika, depo, işyeri)</label></div>
      </fieldset>
      <fieldset>
        <legend>Hangi illere hizmet veriyorsunuz?</legend>
        <div style="display:flex;gap:18px;flex-wrap:wrap">
          <label class="chk"><input type="radio" name="kapsam" value="tum" checked /> Tüm Türkiye</label>
          <label class="chk"><input type="radio" name="kapsam" value="secili" /> Belirli iller</label>
        </div>
        <div id="il-sec" hidden style="margin-top:10px">
          <input type="search" id="il-ara" placeholder="İl ara (ör. Malatya)" aria-label="İl ara" style="margin-bottom:10px" />
          <div class="il-grid">{ILLER.map((il) => <label class="chk"><input type="checkbox" name="il" value={il} /> {il}</label>)}</div>
          <span class="xs muted" id="il-say">Henüz il seçilmedi. Talepler yalnızca seçtiğiniz illerden gelir.</span>
        </div>
      </fieldset>
      <label class="f">Sahip olduğunuz belgeler (yazıyla)<input type="text" name="belgeler" maxlength="300" placeholder="Ör. TSE, ISO 9001, CE, O2 tip onay" /></label>
      <label class="f">Referanslarınız (isteğe bağlı)<textarea name="referanslar" maxlength="1500" placeholder="Teslim ettiğiniz en az 1–3 iş: il, yıl, ev tipi ve teyit için müşteri ya da yüklenici iletişim bilgisi"></textarea></label>
      <label class="f">Not<textarea name="not" maxlength="1000"></textarea></label>
      <div class="hp" aria-hidden="true"><label>Web<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
      <div class="kf-one">
        <label class="chk"><input type="checkbox" name="one" value="1" id="kf-one-ac" /> <span><b>Firmanız daha ön planda dursun mu?</b> Ana sayfadaki reklam alanlarını görün; isterseniz başvurunuza ekleyin. İsteğe bağlıdır.</span></label>
        <div class="kf-paketler" id="kf-paketler" hidden>
          {SITE.reklam.map((r) => <label class="kf-paket"><input type="checkbox" name="reklam" value={r.k} /><span><b>{r.ad}</b><small>{r.aciklama}</small></span><em>{tl(r.fiyat)}<small>/ay</small></em></label>)}
          <p class="small" id="kf-reklam-toplam" data-ab={SITE.abonelik} hidden></p>
          <p class="xs muted" style="margin:0">Bedeller aylıktır ve {SITE.abonelik} TL üyeliğe ektir. Onaydan sonra alan uygunluğunu kontrol edip ödeme bağlantısını ayrıca göndeririz. <a href="/reklam-ver/" target="_blank">Alanların nerede göründüğüne bakın</a></p>
        </div>
      </div>
      <label class="chk"><input type="checkbox" name="gorselIzni" /> <span><b>İsteğe bağlı:</b> Web sitemizdeki ürün fotoğraflarının, kaynağı belirtilerek PrefabrikTeklif’teki ürün sayfalarımızda kullanılmasına izin veriyorum. Böylece ürünleriniz temsili görsel yerine kendi fotoğraflarınızla görünür.</span></label>
      <label class="chk"><input type="checkbox" name="onay" required /> <span><a href="/firma-uyelik-sozlesmesi/" target="_blank">Firma üyelik sözleşmesini</a>, <a href="/abonelik-ve-iptal-kosullari/" target="_blank">abonelik koşullarını</a>, <a href="/kullanici-sozlesmesi/" target="_blank">kullanıcı sözleşmesini</a> ve <a href="/gizlilik-politikasi/" target="_blank">gizlilik politikasını</a> okudum, kabul ediyorum; <a href="/kvkk-aydinlatma-metni/" target="_blank">aydınlatma metnini</a> okudum. {SITE.kampanya.aktif ? "İlk ay ücretsiz; devam edersem" : "Üyelik"} aylık <b>{SITE.abonelik} TL</b>{SITE.kampanya.aktif ? " öderim, istemezsem hiçbir şey ödemem" : " olarak ödenir"}. Verdiğim bilgilerin doğru olduğunu beyan ederim.</span></label>
      <p class="err" id="hata" role="alert" hidden></p>
      <button class="btn btn-p btn-block" type="submit" id="gonder">Kaydı gönder</button>
    </form>
    <div class="ok" id="tamam" hidden>
      <h2 style="margin-top:0">Teşekkürler, başvurunuz alındı</h2>
      <p>Vergi levhanızı kontrol edip en geç 1 iş günü içinde başvurunuzu onaylayacağız.</p>
      <ol style="margin:8px 0 0;padding-left:20px;line-height:1.7">
        <li data-kurucu-yok>Başvurunuz onaylanınca <b>aylık {SITE.abonelik} TL</b> üyelik ödeme bağlantısı e-postanıza gelir.</li>
        <li data-kurucu-yok>Ödemeyi yaptığınızda firmanız sitede <b>“Üye firma”</b> rozetiyle görünür.</li>
        <li data-kurucu-var hidden>Açılış kampanyası kapsamında başvurunuz onaylanınca üyeliğiniz <b>1 ay ücretsiz</b> olarak hemen açılır; firmanız sitede “Üye firma” rozetiyle görünür.</li>
        <li>Size uyan taleplere <a href="/firma-paneli/">firma panelinizden</a> fiyat verirsiniz; fiyat verdiğiniz müşterinin iletişim bilgileri size açılır.</li>
      </ol>
      <p class="small muted" style="margin:10px 0 0"><b>Şifre şimdi gerekmez:</b> başvurunuz onaylanınca e-postanıza “Şifremi belirle ve panele gir” bağlantısı gelir; tek tıkla şifrenizi belirleyip panele girersiniz. Bu adres bir Google hesabıysa Google ile de girebilirsiniz.</p>
    </div>
  </div>
  <script>
    import { kampanyaVar } from '../scripts/katalog';
    import { araliSecIzle } from '../scripts/ui';
    araliSecIzle((document.querySelector('select[name=mevcut]')?.closest('form') as HTMLElement) || document.body);
    kampanyaVar().then((v) => {
      if (!v) return;
      document.getElementById('kampanya-kutu')!.hidden = false;
      document.querySelectorAll<HTMLElement>('[data-kurucu-yok]').forEach((e) => (e.hidden = true));
      document.querySelectorAll<HTMLElement>('[data-kurucu-var]').forEach((e) => (e.hidden = false));
      const d = document.querySelector('#davet-bilgi .small'); if (d) d.innerHTML = '<b>Sizi bekleyen bir müşteri talebi var.</b> Kaydınızı tamamlayın; başvurunuz onaylanınca 1 ay ücretsiz üyelikle bu talebe firma panelinizden fiyat verebilirsiniz.';
    });
  </script>
  <script is:inline>
    (function () {
      var f = document.getElementById('kayit'), q = new URLSearchParams(location.search);
      if (q.get('firma')) { f.mevcut.value = q.get('firma'); var hb = document.querySelector('h1'); if (hb && f.mevcut.value) hb.textContent = 'Firmanızı doğrulayın'; }
      // Evrak: seçilen dosya 900 KB'lık parçalarla yüklenir; yalnızca PDF/PNG/JPEG/HEIC, en fazla 10 MB
      var evrak = {}, yukleniyor = 0, MAKS = 10 * 1024 * 1024;
      function b64(ab) { var s = '', u = new Uint8Array(ab); for (var i = 0; i < u.length; i += 0x8000) s += String.fromCharCode.apply(null, u.subarray(i, i + 0x8000)); return btoa(s); }
      function post(d) { return fetch('/api/belge', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(d) }).then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { if (!r.ok) throw new Error(j.hata || 'Yüklenemedi.'); return j; }); }); }
      document.querySelectorAll('#evrak .ev-s').forEach(function (sat) {
        var inp = sat.querySelector('input'), em = sat.querySelector('em'), tur = sat.dataset.tur;
        inp.addEventListener('change', async function () {
          var d = inp.files && inp.files[0]; inp.value = ''; if (!d) return;
          sat.classList.remove('ok', 'hata'); delete evrak[tur];
          if (!/\.(pdf|png|jpe?g|heic|heif)$/i.test(d.name)) { sat.classList.add('hata'); em.textContent = 'Yalnızca PDF, PNG, JPEG ya da HEIC.'; return; }
          if (d.size > MAKS) { sat.classList.add('hata'); em.textContent = 'Dosya 10 MB’tan büyük (' + (d.size / 1048576).toFixed(1) + ' MB).'; return; }
          if (!d.size) { sat.classList.add('hata'); em.textContent = 'Dosya boş.'; return; }
          yukleniyor++;
          try {
            var b = await post({ islem: 'baslat', ad: d.name, tur: tur, boyut: d.size });
            var n = Math.ceil(d.size / b.parcaBoyut);
            for (var i = 0; i < n; i++) { em.textContent = 'Yükleniyor %' + Math.round((i / n) * 100); var parca = await d.slice(i * b.parcaBoyut, (i + 1) * b.parcaBoyut).arrayBuffer(); await post({ islem: 'parca', id: b.id, anahtar: b.anahtar, i: i, veri: b64(parca) }); }
            await post({ islem: 'bitir', id: b.id, anahtar: b.anahtar });
            evrak[tur] = { id: b.id, anahtar: b.anahtar }; sat.classList.add('ok'); if (window.__kfIlerleme) window.__kfIlerleme(); em.textContent = '✓ ' + d.name + ' (' + (d.size / 1048576).toFixed(1) + ' MB)';
          } catch (er) { sat.classList.add('hata'); em.textContent = er.message; }
          finally { yukleniyor--; }
        });
      });
      var davet = q.get('davet') || ''; if (davet) document.getElementById('davet-bilgi').hidden = false;
      // Listedeki firmayı seçince bilinen bilgiler boş alanlara dolar
      var OZ = {}; try { OZ = JSON.parse(document.getElementById('firma-ozet').textContent || '{}'); } catch (e) {}
      function doldur(slug, zorla) {
        var o = OZ[slug]; if (!o) return;
        [['unvan', o.u], ['marka', o.m], ['web', o.w], ['merkezIl', o.i]].forEach(function (x) { var el = f.elements[x[0]]; if (el && x[1] && (zorla || !el.value)) el.value = x[1]; });
        (o.t || []).forEach(function (t) { var c = f.querySelector('input[name=tipler][value="' + t + '"]'); if (c) c.checked = true; });
      }
      f.mevcut.addEventListener('change', function () { doldur(f.mevcut.value, false); ilerleme(); kaydet(); });
      // Taslak: dosyalar hariç tüm alanlar bu cihazda saklanır, gönderilince silinir
      var TK = 'pt_firma_kayit_taslak';
      function kaydet() { try { var d = {}; [].forEach.call(f.elements, function (el) { if (!el.name || el.type === 'file') return; if (el.type === 'checkbox') { (d[el.name] = d[el.name] || []); if (el.checked) d[el.name].push(el.value); } else if (el.type === 'radio') { if (el.checked) d[el.name] = el.value; } else d[el.name] = el.value; }); localStorage.setItem(TK, JSON.stringify(d)); } catch (e) {} }
      function yukle() { try { var d = JSON.parse(localStorage.getItem(TK) || 'null'); if (!d) return false; var dolu = false; [].forEach.call(f.elements, function (el) { if (!el.name || el.type === 'file' || !(el.name in d)) return; var v = d[el.name]; if (el.type === 'checkbox') { el.checked = Array.isArray(v) && v.indexOf(el.value) >= 0; if (el.checked) dolu = true; } else if (el.type === 'radio') el.checked = v === el.value; else if (v) { el.value = v; dolu = true; } }); if (f.kapsam && f.kapsam.value === 'secili') document.getElementById('il-sec').hidden = false; return dolu; } catch (e) { return false; } }
      // İlerleme: doldurulan zorunlu alanlar
      function ilerleme() {
        var z = [].filter.call(f.elements, function (el) { return el.required && el.type !== 'file' && el.type !== 'checkbox'; });
        var adlar = {}; z.forEach(function (el) { adlar[el.name] = adlar[el.name] || (el.type === 'radio' ? !!f.querySelector('input[name="' + el.name + '"]:checked') : !!(el.value || '').trim()); });

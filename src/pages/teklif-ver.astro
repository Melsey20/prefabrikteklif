---
import Base from '../layouts/Base.astro';
---
<Base title="Talebe fiyat ver" description="Firmalar için fiyat verme sayfası." noindex>
  <div class="wrap narrow" style="padding-top:24px">
    <h1 id="tv-baslik">Sitemizde size uygun bir talep var</h1>
    <p class="muted">Müşteri bilgileri gizlidir. Fiyat vermeyi kabul ederseniz ad, telefon ve e-posta size açılır.</p>
    <p class="err" id="hata" role="alert" hidden></p>
    <div id="talep" class="box" hidden style="display:flex;flex-direction:column;gap:6px"></div>
    <div id="musteri" class="okmsg" hidden style="margin-top:14px"></div>
    <form class="form box" id="f" hidden novalidate style="margin-top:14px">
      <label class="f">Toplam fiyat (TL)<input type="text" name="fiyat" inputmode="numeric" placeholder="Ör. 1.250.000" required /></label>
      <label class="chk"><input type="checkbox" name="kdvDahil" /> Fiyata KDV dahil</label>
      <fieldset>
        <legend>Fiyata dahil olanlar</legend>
        <div class="two">
          <label class="chk"><input type="checkbox" name="dahil" value="nakliye" /> Nakliye</label>
          <label class="chk"><input type="checkbox" name="dahil" value="montaj" /> Montaj</label>
          <label class="chk"><input type="checkbox" name="dahil" value="vinc" /> Vinç</label>
          <label class="chk"><input type="checkbox" name="dahil" value="zemin" /> Zemin betonu</label>
          <label class="chk"><input type="checkbox" name="dahil" value="ic-bitis" /> İç bitiş (parke, fayans)</label>
          <label class="chk"><input type="checkbox" name="dahil" value="mutfak-vitrifiye" /> Mutfak ve vitrifiye</label>
          <label class="chk"><input type="checkbox" name="dahil" value="ruhsat" /> Ruhsat ve proje</label>
        </div>
      </fieldset>
      <div class="two">
        <label class="f">Teslim süresi (gün)<input type="number" name="teslimGun" min="1" max="365" /></label>
        <label class="f">Garanti (yıl)<input type="number" name="garantiYil" min="0" max="50" /></label>
      </div>
      <label class="f">Teklif notu (koşullar, açıklamalar)<textarea name="not" maxlength="2000" rows="4" placeholder="Önerdiğiniz model, malzeme, ödeme planı; “arsa eğimliyse zemin betonu +40.000 TL” gibi koşullar…"></textarea></label>
      <p class="xs muted" style="margin:0">Fiyat verdiğinizde müşteri bilgileri size açılır; bu bilgileri yalnızca bu talep için kullanmayı kabul edersiniz.</p>
      <div style="display:flex;gap:10px;flex-wrap:wrap"><button class="btn btn-p" type="submit">Fiyatı gönder</button><button class="btn btn-g" type="button" id="red">İlgilenmiyorum</button></div>
    </form>
    <div class="ok" id="tamam" hidden style="margin-top:14px"></div>
    <div class="box mint" id="uyelik" hidden style="margin-top:14px;display:flex;flex-direction:column;gap:10px"></div>
    <p class="small muted" style="margin-top:18px">Tüm talepleri <a href="/firma-paneli/">firma panelinden</a> de yönetebilirsiniz. Firmanız kayıtlı değilse <a href="/firma-kayit/">firma üyeliği için başvurun</a>.</p>
  </div>
  <script>
    import { h, tl, paraAlan, paraSayi } from '../scripts/ui';
    document.querySelectorAll<HTMLInputElement>('input[name=fiyat]').forEach((x) => paraAlan(x));
    const q = new URLSearchParams(location.search); const t = q.get('t'); const fr = q.get('f');
    const $ = (id: string) => document.getElementById(id)!;
    const err = (m: string) => { $('hata').textContent = m; $('hata').hidden = false; };
    const musteriGoster = (m: any) => { $('musteri').replaceChildren(h('b', {}, 'Müşteri bilgileri'), h('p', { style: { margin: '6px 0 0' } }, `${m.ad} · `, h('a', { href: 'tel:' + m.telefon }, m.telefon), ' · ', h('a', { href: 'mailto:' + m.eposta }, m.eposta))); $('musteri').hidden = false; };
    async function post(yol: string, body: any) { const r = await fetch(yol, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }); const j = await r.json().catch(() => ({})); if (!r.ok) throw new Error(j.hata || 'Kaydedilemedi.'); return j; }
    (async () => {
      if (!t || !fr) return err('Bağlantı eksik. E-postadaki bağlantıyı kullanın.');
      try {
        const r = await fetch(`/api/talep?t=${encodeURIComponent(t)}&f=${encodeURIComponent(fr)}`); const d = await r.json();
        if (!r.ok) return err(d.hata || 'Talep bulunamadı.');
        $('tv-baslik').textContent = `${d.firmaAd}: size uygun bir talep var`;
        const satir = (k: string, v: any) => (v ? h('p', { style: { margin: 0 } }, h('b', {}, k + ': '), String(v)) : null);
        $('talep').replaceChildren(...[satir('Ev tipi', d.tipAd), satir('Oda', d.oda), satir('m²', d.m2), satir('Yer', [d.il, d.ilce].filter(Boolean).join(' / ')), satir('Arazi', d.araziAd), satir('Bütçe', d.butce), satir('Teslim', d.teslim), satir('Zaman', d.zaman), satir('İstenen kapsam', (d.kapsam || []).join(', ')), satir('İlgilendiği model', d.model), satir('Not', d.not), satir('Son fiyat zamanı', d.sonTarih)].filter(Boolean) as Node[]);
        $('talep').hidden = false;
        if (d.musteri) musteriGoster(d.musteri);
        if (d.verildi) { $('tamam').replaceChildren(h('b', {}, 'Bu talebe fiyat verdiniz.')); $('tamam').hidden = false; return; }
        if (d.red) { $('tamam').replaceChildren(h('b', {}, 'Bu talep için “ilgilenmiyorum” dediniz.')); $('tamam').hidden = false; return; }
        if (d.kapali) return err('Bu talebin süresi doldu.');
        // Fiyat yalnızca üyeliği aktif (doğrulanmış) firmalar verebilir
        if (d.uyeDurum !== 'aktif') {
          const u = $('uyelik');
          u.replaceChildren(...(d.uyeDurum === 'odeme'
            ? [h('b', {}, 'Fiyat verebilmek için üyelik ödemenizi tamamlayın'), h('span', { class: 'small' }, 'Ödemeniz onaylandığında bu talep firma panelinizdeki “Teklif bekleyenler” bölümünde fiyat vermeye açılır.'),
               d.odemeLinki ? h('a', { class: 'btn btn-p', href: d.odemeLinki, target: '_blank', rel: 'noopener', style: { alignSelf: 'flex-start' } }, 'Üyelik ödemesini yap') : null,
               h('a', { class: 'btn btn-g', href: '/firma-paneli/#talepler', style: { alignSelf: 'flex-start' } }, 'Firma panelime git')].filter(Boolean) as Node[]
            : d.kampanya ? [h('b', {}, 'Bu talebe fiyat vermek için firmanızı kaydedin: 1 ay ücretsiz'),
               h('p', { class: 'small', style: { margin: 0, background: '#e7f3ec', borderRadius: '8px', padding: '8px 10px' } }, 'Açılış kampanyası: ilk 50 firmaya 1 ay ücretsiz üyelik, kart bilgisi istemeden. Komisyon yok; sonra aylık üyelik, devam etmezseniz hiçbir şey ödemezsiniz.'),
               h('ol', { class: 'small', style: { margin: 0, paddingLeft: '18px', display: 'grid', gap: '4px' } },
                 h('li', {}, 'Firmanızı kaydedin (birkaç dakika sürer).'),
                 h('li', {}, 'Başvurunuz onaylanınca üyeliğiniz ödeme yapmadan açılır, “Üyeliğiniz aktif” e-postası gelir.'),
                 h('li', {}, 'Bu talebe ve size uyan yeni taleplere panelinizden fiyat verirsiniz; fiyat verdiğinizde müşterinin adı, telefonu ve e-postası açılır.')),
               h('a', { class: 'btn btn-p', href: d.kayitLink, style: { alignSelf: 'flex-start' } }, '1 ay ücretsiz başlayın')]
            : [h('b', {}, 'Bu talebe fiyat vermek için firma üyeliği gerekiyor'),
               h('ol', { class: 'small', style: { margin: 0, paddingLeft: '18px', display: 'grid', gap: '4px' } },
                 h('li', {}, 'Firmanızı kaydedin (birkaç dakika sürer).'),
                 h('li', {}, 'Kaydınız onaylanınca üyelik ödeme bağlantısı e-postanıza gelir.'),
                 h('li', {}, 'Ödemeniz onaylanınca “Üyeliğiniz aktif” e-postası gelir; bu talebe ve size uyan yeni taleplere panelinizden fiyat verirsiniz.')),
               h('span', { class: 'xs muted' }, 'Müşterinin adı ve iletişim bilgileri, fiyat verdiğinizde açılır.'),
               h('a', { class: 'btn btn-p', href: d.kayitLink, style: { alignSelf: 'flex-start' } }, 'Firmamı kaydet')]));
          u.hidden = false; return;
        }
        $('f').hidden = false;
      } catch { err('Bağlantı hatası.'); }
    })();
    $('f').addEventListener('submit', async (e) => {
      e.preventDefault(); const f = e.target as HTMLFormElement; const d: any = { t, f: fr, dahil: [] };
      new FormData(f).forEach((v, k) => { if (k === 'dahil') d.dahil.push(v); else d[k] = v; });
      d.kdvDahil = !!d.kdvDahil; d.fiyat = paraSayi(d.fiyat);
      if (d.fiyat < 1000) return err('Toplam fiyat yazın.');
      try { const j = await post('/api/teklif-ver', d); f.hidden = true; musteriGoster(j.musteri); $('tamam').replaceChildren(h('b', {}, `Fiyatınız (${tl(+d.fiyat)}) kaydedildi.`), h('p', { style: { margin: '6px 0 0' } }, 'Müşteriyi arayıp teklifinizi netleştirebilirsiniz. Süre dolunca tüm teklifler müşteriye tek tabloda iletilecek.')); $('tamam').hidden = false; $('hata').hidden = true; }
      catch (x: any) { err(x.message); }
    });
    $('red').addEventListener('click', async () => {
      try { await post('/api/teklif-red', { t, f: fr }); ($('f') as HTMLElement).hidden = true; $('tamam').replaceChildren(h('b', {}, 'Teşekkürler, kaydettik.')); $('tamam').hidden = false; } catch (x: any) { err(x.message); }
    });
  </script>
</Base>

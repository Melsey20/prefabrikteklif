---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import { SITE } from '../site.config';
import { TIPLER, TIP_SIRA, ILLER, firms } from '../lib/data';
const firmaAd = Object.fromEntries(firms.map((f) => [f.slug, f.kisaAd]));
---
<Base title={`Ücretsiz Teklif Al: ${SITE.teklifSaat} Saatte Firmalardan Fiyat`} description={`Bir kez yazın; prefabrik, çelik, tiny house ve konteyner ev firmaları ${SITE.teklifSaat} saat içinde fiyat versin. Talebiniz isimsiz gider; bilgileriniz yalnızca fiyat veren firmayla paylaşılır. Ücretsiz.`}>
  <div class="wrap narrow">
    <Crumbs items={[{ ad: 'Teklif al' }]} />
    <h1 id="t-h1" data-t={`${SITE.teklifSaat} saatte firmalardan teklif alın`}>{SITE.teklifSaat} saatte firmalardan teklif alın</h1>
    <div class="seg" role="tablist" aria-label="Talep türü" style="margin:6px 0 18px">
      <button type="button" role="tab" aria-selected="true" data-mod="teklif">{SITE.teklifSaat} saatte teklif</button>
      <button type="button" role="tab" aria-selected="false" data-mod="surec">Süreci siz yönetin</button>
    </div>
    <p class="muted" data-mtxt="teklif">Bir kez doldurun. Kriterlerinize uyan firmalar {SITE.teklifSaat} saat içinde fiyat verir; teklifler aynı kapsam başlıklarıyla tek tabloda size gelir. Ücretsiz.</p>
    <p class="muted" data-mtxt="surec" hidden>Evi seçmenize yardım edelim, firmayı birlikte belirleyelim; sözleşmeden teslime kadar üretim, nakliye ve montajı adınıza yerinde takip edelim. Siz firmayla uğraşmazsınız. Ön görüşme ücretsizdir; süreç yönetimi için yalnızca ev bedelinin <b>%{SITE.komisyon}</b>’i kadar hizmet bedeli alırız, gizli ücret yoktur.</p>

    <form class="form" id="teklif" novalidate data-ga="teklif_gonder">
      <input type="hidden" name="mod" value="teklif" />
      <input type="hidden" name="model" />
      <section class="box" style="display:flex;flex-direction:column;gap:14px">
        <h2 style="margin:0;font-size:1.1rem">Aradığınız ev</h2>
        <fieldset>
          <legend class="sr-only">Ev tipi</legend>
          <div class="two">
            {TIP_SIRA.map((k, i) => <label class="opt"><input type="radio" name="tip" value={k} checked={k === 'prefabrik'} required /> {TIPLER[k].ad}</label>)}
          </div>
        </fieldset>
        <div class="two">
          <label class="f">Oda sayısı
            <select name="oda"><option value="">Fark etmez</option><option>1+0</option><option>1+1</option><option>2+1</option><option>3+1</option><option>4+1</option><option>5+1</option></select>
          </label>
          <label class="f">Yaklaşık m²
            <input type="number" name="m2" inputmode="numeric" min="10" max="1000" placeholder="Ör: 80" />
          </label>
        </div>
        <div class="two">
          <label class="f">Teslim şekli
            <select name="teslim"><option value="">Emin değilim</option><option value="anahtar">Anahtar teslim</option><option value="kaba">Kaba / ileri kaba</option></select>
          </label>
          <label class="f">Bütçe
            <select name="butce"><option value="">Belirtmek istemiyorum</option><option value="0-500000">500 bin TL altı</option><option value="500000-1000000">500 bin – 1 milyon TL</option><option value="1000000-2000000">1 – 2 milyon TL</option><option value="2000000-999999999">2 milyon TL üstü</option></select>
          </label>
        </div>
        <fieldset>
          <legend>Evin kurulacağı yer</legend>
          <div class="two">
            <label class="opt"><input type="radio" name="arazi" value="imarli" checked /> İmarlı arsa</label>
            <label class="opt"><input type="radio" name="arazi" value="koy" /> Köy yerleşik alanı</label>
            <label class="opt"><input type="radio" name="arazi" value="tarla" /> Tarla / tarım arazisi</label>
            <label class="opt"><input type="radio" name="arazi" value="bag" /> Bağ – bahçe</label>
            <label class="opt"><input type="radio" name="arazi" value="yok" /> Henüz arsam yok</label>
          </div>
          <span class="small muted">Tarım arazisinde sabit eve ruhsat çoğu zaman çıkmaz. <a href="/arazim-uygun-mu/">Arazim uygun mu?</a></span>
        </fieldset>
        <div class="two">
          <label class="f">İl
            <select name="il" required><option value="">Seçin</option>{ILLER.map((il) => <option>{il}</option>)}</select>
          </label>
          <label class="f">İlçe<input type="text" name="ilce" autocomplete="address-level2" maxlength="60" /></label>
        </div>
        <label class="f">Ne zaman?
          <select name="zaman"><option>3 ay içinde</option><option>3–6 ay</option><option>6 aydan sonra</option><option>Sadece fiyat araştırıyorum</option></select>
        </label>
        <fieldset data-mfield="teklif">
          <legend>Teklifte ne olsun?</legend>
          <label class="chk"><input type="checkbox" name="kapsam" value="anahtar-teslim" checked /> Anahtar teslim fiyat</label>
          <label class="chk"><input type="checkbox" name="kapsam" value="nakliye-montaj" checked /> Nakliye ve montaj</label>
          <label class="chk"><input type="checkbox" name="kapsam" value="zemin-betonu" /> Zemin betonu</label>
          <label class="chk"><input type="checkbox" name="kapsam" value="ruhsat-proje" /> Ruhsat ve proje işleri</label>
        </fieldset>
        <div id="secili-firmalar" hidden>
          <span class="small" style="font-weight:800">Öncelikli firmalar</span>
          <ul class="pills" id="sf-liste" style="margin-top:6px"></ul>
          <span class="xs muted">Talep bu firmalara ve kriterlerinize uyan diğer kayıtlı firmalara gider.</span>
        </div>
        <label class="f">Notunuz (isteğe bağlı)
          <textarea name="not" maxlength="1000" placeholder="Ör: Verandalı olsun, eğimli arazi, kış başlamadan teslim istiyorum"></textarea>
        </label>
      </section>

      <section class="box" style="display:flex;flex-direction:column;gap:14px">
        <h2 style="margin:0;font-size:1.1rem">Size nasıl ulaşalım?</h2>
        <label class="f">Ad soyad<input type="text" name="ad" autocomplete="name" required maxlength="80" /></label>
        <div class="two">
          <label class="f">Telefon<input type="tel" name="telefon" autocomplete="tel" required maxlength="20" placeholder="05xx xxx xx xx" /></label>
          <label class="f">E-posta<input type="email" name="eposta" autocomplete="email" required maxlength="120" /></label>
        </div>
        <div class="hp" aria-hidden="true"><label>Web sitesi<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
        <label class="chk" data-mfield="teklif"><input type="checkbox" name="riza" /> <span>Talep bilgilerimin firmalara <b>isimsiz</b> gönderilmesini; ad, telefon ve e-postamın yalnızca <b>fiyat vermeyi kabul eden firmalarla</b> paylaşılmasını kabul ediyor, bu aktarım için <a href="/kvkk-aydinlatma-metni/#acik-riza" target="_blank">açık rıza</a> veriyorum. <a href="/kvkk-aydinlatma-metni/" target="_blank">Aydınlatma metni</a></span></label>
        <label class="chk" data-mfield="surec" hidden><input type="checkbox" name="rizaSurec" /> <span>Bilgilerimin süreci yürütmek için {SITE.ad} ekibi ve birlikte seçeceğimiz firma ile paylaşılmasına <a href="/kvkk-aydinlatma-metni/#acik-riza" target="_blank">açık rıza</a> veriyorum. <a href="/kvkk-aydinlatma-metni/" target="_blank">Aydınlatma metni</a></span></label>
        <label class="chk"><input type="checkbox" name="pazarlama" /> <span>Fiyat düşüşü ve yeni modellerden e-postayla haberdar olmak istiyorum (isteğe bağlı).</span></label>
        <p class="err" id="hata" role="alert" hidden></p>
        <button class="btn btn-p btn-block" type="submit" id="gonder">Talebi gönder</button>
      </section>
    </form>

    <section class="box mint" style="margin-top:16px" data-mfield="teklif">
      <h2 style="margin:0 0 12px;font-size:1.1rem;color:var(--green-d)">Bilgileriniz nasıl korunuyor?</h2>
      <ol class="numlist">
        <li><span><b>Talebiniz isimsiz gider.</b> Firmalar yalnızca evin özelliklerini ve ili görür.</span></li>
        <li><span><b>Firma fiyat vermeyi kabul eder.</b> Fiyatını giren firmaya adınız, telefonunuz ve e-postanız açılır.</span></li>
        <li><span><b>{SITE.teklifSaat} saat sonra karşılaştırma.</b> Gelen teklifleri tek tabloda e-postanıza ve hesabınıza göndeririz.</span></li>
      </ol>
    </section>
    <section class="box dk" style="margin-top:16px" data-mfield="surec" hidden>
      <h2 style="margin:0 0 10px;font-size:1.1rem">Süreci nasıl yönetiyoruz?</h2>
      <ol class="numlist" style="color:#e3ece6">
        <li><span><b style="color:#fff">Keşif ve ihtiyaç analizi.</b> Arsanızı ve ihtiyacınızı dinler, uygun modelleri ve firmaları önerir.</span></li>
        <li><span><b style="color:#fff">Firma seçimi ve sözleşme.</b> Teklifleri birlikte değerlendirir, sözleşmeyi kontrol ederiz.</span></li>
        <li><span><b style="color:#fff">Üretim, nakliye, montaj, teslim.</b> Her adımı yerinde takip eder, hesabınızda güncelleriz.</span></li>
      </ol>
      <p style="margin:12px 0 0;color:#e3ece6"><b style="color:#fff">Şeffaf ücret: %{SITE.komisyon}.</b> Hizmet bedelimiz anlaştığınız ev bedelinin %{SITE.komisyon}’idir ve sözleşmeden önce tutar olarak yazılı bildirilir. Ev bedelini doğrudan firmaya ödersiniz; sitede ödeme alınmaz.</p>
    </section>
  </div>
  <script define:vars={{ FIRMA_AD: firmaAd }}>
    window.__FIRMA_AD = FIRMA_AD;
  </script>
  <script>
    const form = document.getElementById('teklif') as HTMLFormElement;
    const q = new URLSearchParams(location.search);
    const FIRMA_AD: Record<string, string> = (window as any).__FIRMA_AD || {};
    let mod = q.get('mod') === 'surec' ? 'surec' : 'teklif';
    function modSec(m: string) {
      mod = m; (form.elements.namedItem('mod') as HTMLInputElement).value = m;
      document.querySelectorAll<HTMLButtonElement>('[data-mod]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.mod === m)));
      document.querySelectorAll<HTMLElement>('[data-mtxt],[data-mfield]').forEach((e) => { e.hidden = (e.dataset.mtxt || e.dataset.mfield) !== m; });
      const h1 = document.getElementById('t-h1')!; h1.textContent = m === 'surec' ? 'Süreci biz yönetelim' : h1.dataset.t!;
      document.getElementById('gonder')!.textContent = m === 'surec' ? 'Ön görüşme talep et' : 'Talebi gönder';
    }
    document.querySelectorAll<HTMLButtonElement>('[data-mod]').forEach((b) => b.addEventListener('click', () => modSec(b.dataset.mod!)));
    modSec(mod);
    const set = (n: string, v: string | null) => { if (!v) return; const el = form.elements.namedItem(n) as any; if (!el) return; if (el instanceof RadioNodeList) { const r = form.querySelector<HTMLInputElement>(`input[name="${n}"][value="${CSS.escape(v)}"]`); if (r) r.checked = true; } else el.value = v; };
    ['tip', 'oda', 'm2', 'il', 'ilce', 'butce', 'teslim', 'arazi', 'model'].forEach((k) => set(k, q.get(k)));
    if (q.get('arazi') === 'bag') set('arazi', 'bag');
    let firmalar = (q.get('firmalar') || '').split(',').filter((s) => FIRMA_AD[s]).slice(0, 5);
    function firmaCiz() {
      const box = document.getElementById('secili-firmalar')!; const ul = document.getElementById('sf-liste')!; ul.innerHTML = '';
      box.hidden = !firmalar.length;
      for (const s of firmalar) { const li = document.createElement('li'); const a = document.createElement('a'); a.href = '#'; a.className = 'on'; a.textContent = FIRMA_AD[s] + ' ✕'; a.addEventListener('click', (e) => { e.preventDefault(); firmalar = firmalar.filter((x) => x !== s); firmaCiz(); }); li.append(a); ul.append(li); }
    }
    firmaCiz();
    // Giriş yapmış kullanıcının bilgilerini doldur
    try { const u = JSON.parse(localStorage.getItem('pt_user') || 'null'); if (u) { set('ad', u.ad || ''); set('eposta', u.eposta || ''); } } catch { /* */ }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const hata = document.getElementById('hata')!; hata.hidden = true;
      const fd = new FormData(form); const d: Record<string, any> = { kapsam: [] };
      fd.forEach((v, k) => { if (k === 'kapsam') d.kapsam.push(v); else d[k] = v; });
      d.firmalar = firmalar; d.riza = mod === 'surec' ? !!d.rizaSurec : !!d.riza;
      const tel = String(d.telefon || '').replace(/\D/g, '');
      const msg = !d.ad ? 'Ad soyad yazın.' : tel.length < 10 ? 'Geçerli bir telefon yazın.' : !/^\S+@\S+\.\S+$/.test(d.eposta || '') ? 'Geçerli bir e-posta yazın.' : !d.il ? 'İl seçin.' : !d.riza ? 'Devam etmek için açık rıza kutusunu işaretleyin.' : '';
      if (msg) { hata.textContent = msg; hata.hidden = false; hata.scrollIntoView({ block: 'center' }); return; }
      const btn = document.getElementById('gonder') as HTMLButtonElement; btn.disabled = true; btn.textContent = 'Gönderiliyor…';
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      try {
        if (localStorage.getItem('pt_user')) { const { token } = await import('../scripts/fb'); const t = await token(); if (t) headers.Authorization = 'Bearer ' + t; }
      } catch { /* oturum yok */ }
      try {
        const r = await fetch('/api/teklif', { method: 'POST', headers, body: JSON.stringify(d) });
        const j = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(j.hata || 'Gönderilemedi.');
        (window as any).gtag?.('event', 'generate_lead', { mod });
        location.href = `/teklif-alindi/?mod=${mod}&n=${j.firmaSayisi || 0}`;
      } catch (err: any) { hata.textContent = err.message + ' Lütfen tekrar deneyin.'; hata.hidden = false; btn.disabled = false; btn.textContent = mod === 'surec' ? 'Ön görüşme talep et' : 'Talebi gönder'; }
    });
  </script>
</Base>

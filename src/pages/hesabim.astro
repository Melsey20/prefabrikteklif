---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';
---
<Base title="Hesabım" description="Talepleriniz, gelen teklifler, favori evleriniz ve süreç takibiniz." noindex>
  <div class="wrap hs" id="hs">
    <section class="hs-bas">
      <span class="hs-av" id="hs-av" aria-hidden="true">·</span>
      <div class="hs-kim">
        <h1 id="hs-ad">Hesabım</h1>
        <span class="small muted" id="hs-eposta">&nbsp;</span>
      </div>
      <div class="hs-ust-btn">
        <a class="btn btn-p btn-s" href="/teklif-al/">Yeni teklif al</a>
        <button class="btn btn-g btn-s" type="button" data-cikis>Çıkış yap</button>
      </div>
    </section>
    <div id="hs-uyari"></div>

    <div class="hs-ozet" id="hs-ozet">
      <button type="button" data-git="talepler"><span>Açık talep</span><strong data-say="acik">–</strong></button>
      <button type="button" data-git="talepler"><span>Gelen teklif</span><strong data-say="teklif">–</strong></button>
      <button type="button" data-git="favoriler"><span>Favori ev</span><strong data-say="favori">–</strong></button>
      <button type="button" data-git="surec"><span>Süreç takibi</span><strong data-say="siparis">–</strong></button>
    </div>

    <nav class="hs-sek" role="tablist" aria-label="Hesap bölümleri" id="hs-sek">
      <button type="button" role="tab" data-p="genel" aria-selected="true">Genel bakış</button>
      <button type="button" role="tab" data-p="talepler">Taleplerim <span class="rz" data-rz="talepler"></span></button>
      <button type="button" role="tab" data-p="favoriler">Favorilerim</button>
      <button type="button" role="tab" data-p="surec">Süreç takibi <span class="rz" data-rz="surec"></span></button>
      <button type="button" role="tab" data-p="ayarlar">Hesap ayarları</button>
    </nav>

    <section class="hs-p" data-panel="genel" id="p-genel"><div class="sk"></div><div class="sk"></div></section>
    <section class="hs-p" data-panel="talepler" id="p-talepler" hidden></section>
    <section class="hs-p" data-panel="favoriler" id="p-favoriler" hidden><div class="grid" id="fav-liste"></div></section>
    <section class="hs-p" data-panel="surec" id="p-surec" hidden></section>
    <section class="hs-p" data-panel="ayarlar" id="p-ayarlar" hidden></section>
  </div>
  <script define:vars={{ KOMISYON: SITE.komisyon, SAAT: SITE.teklifSaat }}>window.__HS = { KOMISYON, SAAT };</script>
  <script>
    import { onayIste } from '../scripts/onayKutusu';
    import { kullanici, api, oturumAc, cikis, dogrulamaGonder, sifreSifirla, adGuncelle, hataYazi } from '../scripts/fb';
    import { h, tl, tarih, toast, hataGoster } from '../scripts/ui';
    import { modeller, kart, TIP_IMG } from '../scripts/modeller';
    const { KOMISYON, SAAT } = (window as any).__HS;
    const $ = (id: string) => document.getElementById(id)!;
    let veri: any = null; let uid = '';
    const say = (k: string, v: number) => { const e = document.querySelector(`[data-say=${k}]`); if (e) e.textContent = String(v); };
    const sure = (ms: number) => { const s = Math.round((ms - Date.now()) / 3600000); return s > 0 ? (s >= 24 ? `${Math.floor(s / 24)} gün ${s % 24} saat` : `${s} saat`) : ''; };
    const baslik = (t: any) => [t.tipAd, t.oda, t.m2 ? `${t.m2} m²` : '', [t.il, t.ilce].filter(Boolean).join(' / ')].filter(Boolean).join(' · ');

    // ---- Sekmeler (adres çubuğundaki #bölüm ile) ----
    function ac(p: string) {
      if (p === 'teklifler') p = 'talepler';
      if (!document.querySelector(`.hs-sek [data-p="${p}"]`)) p = 'genel';
      document.querySelectorAll<HTMLElement>('.hs-sek [data-p]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.p === p)));
      document.querySelectorAll<HTMLElement>('.hs-p').forEach((s) => (s.hidden = s.dataset.panel !== p));
      if (p === 'favoriler') favCiz();
      history.replaceState(null, '', '#' + p);
    }
    $('hs-sek').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-p]'); if (b) ac(b.dataset.p!); });
    $('hs-ozet').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-git]'); if (b) { ac(b.dataset.git!); $('hs-sek').scrollIntoView({ behavior: 'smooth', block: 'start' }); } });

    // ---- Talep ilerleme çubuğu ----
    function ilerleme(t: any) {
      const acik = t.durum === 'acik'; const n = t.teklifler.length;
      const adim = acik ? (n ? 2 : 1) : 3;
      const ad = ['Talep gönderildi', n ? `${n} teklif geldi` : 'Firmalar fiyat veriyor', 'Karşılaştırma hazır'];
      return h('ol', { class: 'hs-ilerle' }, ...ad.map((a, i) => h('li', { class: i + 1 < adim ? 'ok' : i + 1 === adim ? 'now' : '' }, h('i', {}, i + 1 < adim ? '✓' : String(i + 1)), h('span', {}, a))));
    }
    function mesajKutu(x: any, t: any) {
      const m = x.mesajlar || [];
      const metin = h('textarea', { rows: 2, maxlength: 2000, placeholder: `${x.firma} firmasına sorunuzu yazın` }) as HTMLTextAreaElement;
      return h('details', { class: 'mj-kutu', open: m.length > 0 }, h('summary', {}, `Firmayla mesajlaşma${m.length ? ` (${m.length})` : ''}`),
        h('div', { class: 'mj-liste' }, ...m.map((y: any) => h('div', { class: 'mj ' + (y.kim === 'musteri' ? 'ben' : '') }, h('span', { class: 'xs muted' }, (y.kim === 'musteri' ? 'Siz' : x.firma) + ' · ' + tarih(y.zaman)), h('p', {}, y.metin)))),
        h('form', { class: 'mj-form', onsubmit: async (e: Event) => { e.preventDefault(); if (metin.value.trim().length < 2) return; try { await api('/api/mesaj', { talep: t.id, firma: x.firmaSlug, metin: metin.value }); toast('Mesajınız firmaya iletildi'); await yukle(); ac('talepler'); } catch (err: any) { toast(err.message); } } }, metin, h('button', { class: 'btn btn-p btn-s', type: 'submit' }, 'Gönder')));
    }
    function teklifKart(x: any, en: boolean, t: any) {
      return h('article', { class: 'hs-tk' + (en ? ' en' : '') },
        en ? h('span', { class: 'hs-en' }, 'En uygun') : null,
        h('a', { class: 'hs-tk-f', href: `/firma/${x.firmaSlug}/` }, x.firma),
        h('strong', { class: 'hs-tk-p' }, tl(x.fiyat)), h('span', { class: 'xs muted' }, x.kdvDahil ? 'KDV dahil' : 'KDV hariç'),
        x.dahil?.length ? h('ul', { class: 'tags' }, ...x.dahil.map((d: string) => h('li', { class: 'd' }, d + ' dahil'))) : h('span', { class: 'xs muted' }, 'Dahil kalem belirtilmedi'),
        h('span', { class: 'small' }, [x.teslimGun ? `Teslim ${x.teslimGun} gün` : '', x.garantiYil ? `${x.garantiYil} yıl garanti` : ''].filter(Boolean).join(' · ')),
        x.not ? h('details', {}, h('summary', { class: 'small' }, 'Firmanın notu'), h('p', { class: 'small', style: { whiteSpace: 'pre-line', margin: '6px 0 0' } }, x.not)) : null,
        x.iletisim ? h('div', { class: 'tk-iletisim' },
          x.iletisim.telefon ? h('a', { class: 'btn btn-p btn-s', href: 'tel:' + x.iletisim.telefon.replace(/\s/g, '') }, '📞 Ara') : null,
          x.iletisim.eposta ? h('a', { class: 'btn btn-g btn-s', href: `mailto:${x.iletisim.eposta}?subject=${encodeURIComponent('PrefabrikTeklif teklifiniz: ' + baslik(t))}` }, '✉️ E-posta') : null,
          h('button', { class: 'btn btn-g btn-s', type: 'button', onclick: (e: Event) => { const d = (e.currentTarget as HTMLElement).closest('.hs-tk')!.querySelector('details.mj-kutu') as HTMLDetailsElement; d.open = true; d.querySelector('textarea')?.focus(); } }, '💬 Soru sor')) : null,
        mesajKutu(x, t),
        h('div', { class: 'hs-tk-b' },
          h('a', { class: 'btn btn-l btn-s', href: `/teklif-al/?mod=surec&firmalar=${encodeURIComponent(x.firmaSlug)}&tip=${encodeURIComponent(t.tip || '')}` }, 'Süreci siz yönetin'),
          h('a', { class: 'btn btn-g btn-s', href: `/yorum-yaz/?firma=${encodeURIComponent(x.firmaSlug)}` }, 'Yorum yaz')));
    }
    function talepKart(t: any, kisa = false) {
      const acik = t.durum === 'acik'; const kalanS = acik ? sure(t.sonTarihMs) : '';
      const ozellik = [t.araziAd, t.butce, t.teslim, t.zaman, ...(t.kapsam || [])].filter(Boolean);
      const teklifler = kisa ? t.teklifler.slice(0, 3) : t.teklifler;
      return h('article', { class: 'hs-talep box' },
        h('div', { class: 'hs-t-ust' },
          h('img', { src: `/img/${TIP_IMG[t.tip] || 'prefabrik'}-kare.webp`, alt: '', width: 56, height: 56, loading: 'lazy' }),
          h('div', { style: { flex: 1, minWidth: 0 } }, h('b', { class: 'hs-t-b' }, baslik(t)), h('span', { class: 'xs muted' }, `${tarih(t.olusturma)} tarihinde gönderildi`)),
          h('span', { class: 'st-b ' + (acik ? 'a' : 'g') }, acik ? (kalanS ? `${kalanS} kaldı` : 'Süre doluyor') : 'Tamamlandı')),
        ilerleme(t),
        !kisa && ozellik.length ? h('ul', { class: 'tags' }, ...ozellik.map((o) => h('li', { class: 'b' }, o))) : null,
        !kisa && t.model ? h('span', { class: 'small' }, 'İlgilendiğiniz model: ', h('b', {}, t.model)) : null,
        teklifler.length ? h('div', { class: 'hs-tkler' }, ...teklifler.map((x: any, i: number) => teklifKart(x, i === 0 && t.teklifler.length > 1, t)))
          : h('p', { class: 'small muted', style: { margin: 0 } }, acik ? `Talebiniz firmalara iletildi. Fiyat veren firmalar burada ve e-postanızda görünecek; süre dolunca tüm teklifler tek tabloda gelir.` : 'Bu talebe sistem üzerinden fiyat girilmedi; ekibimiz sizinle iletişime geçecek.'),
        (t.sorular || []).length ? h('div', { class: 'hs-sorular' }, h('b', { class: 'small' }, 'Fiyat vermeden önce size soru soran firmalar'), h('span', { class: 'xs muted' }, 'Yanıtlarsanız firma daha doğru fiyat verir. Adınız ve iletişim bilgileriniz fiyat verene kadar firmaya gizli kalır.'), ...t.sorular.map((x: any) => { const k = mesajKutu(x, t) as HTMLDetailsElement; k.open = true; (k.querySelector('summary') as HTMLElement).textContent = `${x.firma} soruyor (${x.mesajlar.length})`; return k; })) : null,
        kisa && t.teklifler.length > 3 ? h('button', { class: 'btn btn-l btn-s', type: 'button', style: { alignSelf: 'flex-start' }, onclick: () => ac('talepler') }, `Tüm ${t.teklifler.length} teklifi gör`) : null);
    }

    // ---- Paneller ----
    function genelCiz() {
      const box = $('p-genel'); const T = veri.talepler; const S = veri.siparisler;
      const parcalar: Node[] = [];
      if (S.length) parcalar.push(h('div', { class: 'box hs-surec-mini' }, h('span', { class: 'xs', style: { fontWeight: 800, color: 'var(--green)' } }, 'SÜRECİ BİZ YÖNETİYORUZ'),
        h('b', {}, S[0].model || [S[0].tipAd, S[0].m2 ? `${S[0].m2} m²` : '', S[0].oda].filter(Boolean).join(' · ')),
        h('span', { class: 'small' }, `Şu anki aşama: `, h('b', {}, S[0].asamalar[S[0].asama])), h('button', { class: 'btn btn-l btn-s', type: 'button', style: { alignSelf: 'flex-start' }, onclick: () => ac('surec') }, 'Süreci görüntüle')));
      if (T.length) { parcalar.push(h('h2', { class: 'hs-h2' }, 'Son talebiniz'), talepKart(T[0], true)); }
      else parcalar.push(h('div', { class: 'hs-bos box' },
        h('b', { style: { fontSize: '1.15rem' } }, 'Henüz teklif almadınız'),
        h('p', { class: 'small muted', style: { margin: '4px 0 14px' } }, `Bir kez yazın; uygun firmalar ${SAAT} saat içinde fiyat versin. İletişim bilgileriniz yalnızca fiyat veren firmayla paylaşılır.`),
        h('div', { class: 'hs-yol' },
          h('a', { href: '/evini-bul/' }, h('b', {}, '1. Evinizi bulun'), h('span', {}, 'Tip, m², oda ve bütçe ile uygun modeller')),
          h('a', { href: '/teklif-al/' }, h('b', {}, '2. Teklif alın'), h('span', {}, 'Talebiniz firmalara isimsiz gider')),
          h('a', { href: '/teklif-al/?mod=surec' }, h('b', {}, '3. Süreci bize bırakın'), h('span', {}, `Ev bedelinin %${KOMISYON}’i ile sözleşmeden teslime kadar`))),
        h('p', { class: 'xs muted', style: { margin: '12px 0 0' } }, 'Talebi giriş yapmadan ya da başka bir e-postayla gönderdiyseniz: talep e-postanızdaki “Talebimi takip et” düğmesine bu hesapla açıkken dokunun, talebiniz ve gelen teklifler buraya eklenir.')));
      const fav: string[] = JSON.parse(localStorage.getItem('pt_fav') || '[]');
      parcalar.push(h('div', { class: 'hs-ikili' },
        h('a', { class: 'box hs-kutu', href: '#favoriler', onclick: (e: Event) => { e.preventDefault(); ac('favoriler'); } }, h('b', {}, `Favori evleriniz (${fav.length})`), h('span', { class: 'small muted' }, fav.length ? 'Kaydettiğiniz evleri görün, karşılaştırın.' : 'Kartlardaki kalp simgesiyle ev kaydedin.')),
        h('a', { class: 'box hs-kutu', href: '/firmalar/' }, h('b', {}, 'Firmaları inceleyin'), h('span', { class: 'small muted' }, 'Üretici profilleri, yorumlar ve doğrulanmış firmalar.'))));
      box.replaceChildren(...parcalar);
    }
    function talepCiz() {
      const box = $('p-talepler');
      if (!veri.talepler.length) { box.replaceChildren(h('div', { class: 'empty' }, h('b', {}, 'Henüz teklif talebiniz yok.'), h('p', { class: 'small', style: { margin: '6px 0 12px' } }, 'Tek formla uygun firmalardan fiyat alın.'), h('p', { class: 'xs muted', style: { margin: '12px 0 0' } }, 'Talebi giriş yapmadan ya da başka bir e-postayla gönderdiyseniz: talep e-postanızdaki “Talebimi takip et” düğmesine bu hesapla açıkken dokunun, talebiniz ve gelen teklifler buraya eklenir.'), h('a', { class: 'btn btn-p btn-s', href: '/teklif-al/' }, 'Teklif al'))); return; }
      box.replaceChildren(...veri.talepler.map((t: any) => talepKart(t)));
    }
    let favYuklendi = false;
    async function favCiz() {
      const ids: string[] = JSON.parse(localStorage.getItem('pt_fav') || '[]');
      say('favori', ids.length);
      if (!ids.length) { $('fav-liste').innerHTML = '<div class="empty" style="grid-column:1/-1"><b>Favori eviniz yok.</b><p class="small" style="margin:6px 0 0">Ev kartlarındaki kalp simgesine dokunarak kaydedin.</p></div>'; return; }
      if (!favYuklendi) $('fav-liste').innerHTML = '<div class="sk"></div><div class="sk"></div>';
      const all = await modeller(); favYuklendi = true;
      const list = ids.map((id) => all.find((m) => m.id === id)).filter(Boolean) as any[];
      $('fav-liste').innerHTML = list.map(kart).join('');
      window.dispatchEvent(new Event('pt:draw'));
    }
    function surecCiz() {
      const box = $('p-surec');
      if (!veri.siparisler.length) { box.replaceChildren(h('div', { class: 'empty' }, h('b', {}, 'Henüz yönettiğimiz bir süreciniz yok.'), h('p', { class: 'small', style: { margin: '6px 0 12px' } }, `Evi seçtiyseniz firmayı birlikte seçip sözleşmeden teslime kadar takip edelim. Hizmet bedeli ev bedelinin %${KOMISYON}’i.`), h('a', { class: 'btn btn-p btn-s', href: '/teklif-al/?mod=surec' }, 'Süreci siz yönetin'))); return; }
      box.replaceChildren(...veri.siparisler.map((s: any) => {
        const not = (i: number) => s.notlar.filter((n: any) => n.asama === i).map((n: any) => n.metin).join(' · ');
        const mesajKutu = h('textarea', { rows: 2, placeholder: 'Proje sorumlunuza mesaj yazın', maxlength: 1500 }) as HTMLTextAreaElement;
        return h('article', { class: 'box', style: { display: 'flex', flexDirection: 'column', gap: '14px', marginBottom: '14px' } },
          h('div', { style: { display: 'flex', gap: '12px', alignItems: 'center' } },
            h('img', { src: `/img/${TIP_IMG[s.tip] || 'prefabrik'}-kare.webp`, alt: '', width: 56, height: 56, style: { borderRadius: '14px' } }),
            h('span', {}, h('b', { style: { display: 'block' } }, s.model || [s.tipAd, s.m2 ? `${s.m2} m²` : '', s.oda].filter(Boolean).join(' · ')), h('span', { class: 'small muted' }, [s.firma, s.il].filter(Boolean).join(' · ') || 'Firma seçimi devam ediyor'))),
          h('ol', { class: 'steps' }, ...s.asamalar.map((a: string, i: number) => h('li', { class: i < s.asama ? 'ok' : i === s.asama ? 'now' : '' }, h('span', {}, h('b', {}, a), h('span', {}, not(i) || (i === s.asama ? 'Şu an bu aşamadayız' : '')))))),
          s.belgeler.length ? h('div', { style: { display: 'flex', flexDirection: 'column', gap: '6px' } }, h('b', { class: 'small' }, 'Belgeler'), ...s.belgeler.map((b: any) => h('a', { class: 'pill', href: b.url, target: '_blank', rel: 'noopener' }, b.ad))) : null,
          s.mesajlar.length ? h('div', { class: 'list' }, ...s.mesajlar.map((m: any) => h('div', { class: 'item', style: m.kim === 'musteri' ? { background: 'var(--green-ll)' } : {} }, h('span', { class: 'xs muted' }, (m.kim === 'musteri' ? 'Siz' : 'Proje sorumlusu') + ' · ' + tarih(m.zaman)), h('span', {}, m.metin)))) : null,
          h('form', { class: 'form', style: { gap: '8px' }, onsubmit: async (e: Event) => { e.preventDefault(); if (mesajKutu.value.trim().length < 2) return; try { await api('/api/siparis-mesaj', { siparis: s.id, metin: mesajKutu.value }); toast('Mesajınız iletildi'); yukle(); } catch (err: any) { toast(err.message); } } }, mesajKutu, h('button', { class: 'btn btn-p btn-s', type: 'submit', style: { alignSelf: 'flex-start' } }, 'Proje sorumluma yaz')));
      }));
    }
    function ayarCiz() {
      const b = veri.ben;
      const ad = h('input', { type: 'text', maxlength: 60, value: b.ad || '', autocomplete: 'name' }) as HTMLInputElement;
      $('p-ayarlar').replaceChildren(h('div', { class: 'hs-ayar' },
        h('div', { class: 'box' }, h('h2', { class: 'hs-h2', style: { marginTop: 0 } }, 'Kişisel bilgiler'),
          h('label', { class: 'f' }, 'Ad soyad', ad),
          h('button', { class: 'btn btn-p btn-s', type: 'button', style: { alignSelf: 'flex-start' }, onclick: async () => { try { await adGuncelle(ad.value.trim()); toast('Adınız güncellendi'); veri.ben.ad = ad.value.trim(); basCiz(); } catch (e) { toast(hataYazi(e)); } } }, 'Kaydet')),
        h('div', { class: 'box' }, h('h2', { class: 'hs-h2', style: { marginTop: 0 } }, 'E-posta ve güvenlik'),
          h('span', {}, h('b', {}, b.eposta), ' ', h('span', { class: 'st-b ' + (b.dogrulandi ? 'g' : 'a') }, b.dogrulandi ? 'Doğrulandı' : 'Doğrulanmadı')),
          !b.dogrulandi ? h('button', { class: 'btn btn-l btn-s', type: 'button', style: { alignSelf: 'flex-start' }, onclick: async () => { try { await dogrulamaGonder(); toast('Doğrulama e-postası gönderildi'); } catch (e) { toast(hataYazi(e)); } } }, 'Doğrulama e-postası gönder') : null,
          h('button', { class: 'btn btn-g btn-s', type: 'button', style: { alignSelf: 'flex-start' }, onclick: async () => { try { await sifreSifirla(b.eposta); toast('Şifre belirleme bağlantısı e-postanıza gönderildi'); } catch (e) { toast(hataYazi(e)); } } }, 'Şifre belirle / değiştir')),
        b.rol !== 'kullanici' ? h('div', { class: 'box' }, h('h2', { class: 'hs-h2', style: { marginTop: 0 } }, 'Paneller'),
          b.rol === 'firma' || b.firma ? h('a', { class: 'btn btn-p btn-s', href: '/firma-paneli/', style: { alignSelf: 'flex-start' } }, 'Firma paneline git') : null,
          b.rol === 'admin' ? h('a', { class: 'btn btn-d btn-s', href: '/yonetim/', style: { alignSelf: 'flex-start' } }, 'Yönetim paneli') : null) : null,
        h('div', { class: 'box' }, h('h2', { class: 'hs-h2', style: { marginTop: 0 } }, 'Oturum ve veriler'),
          h('button', { class: 'btn btn-g btn-s', type: 'button', style: { alignSelf: 'flex-start' }, onclick: async () => { try { localStorage.removeItem('pt_hesap_' + uid); } catch { /* */ } await cikis(); location.href = '/'; } }, 'Çıkış yap'),
          h('span', { class: 'xs muted' }, 'Kişisel verilerinizin silinmesini ya da bir kopyasını istemek için ', h('a', { href: '/iletisim/' }, 'bize yazın'), '. ', h('a', { href: '/kvkk-aydinlatma-metni/' }, 'Aydınlatma metni')))));
    }
    function basCiz() {
      const b = veri.ben; const ad = (b.ad || '').trim();
      $('hs-ad').textContent = ad ? `Merhaba ${ad.split(/\s+/)[0]}` : 'Hesabım';
      $('hs-eposta').textContent = b.eposta || b.telefon || '';
      $('hs-av').textContent = (ad || b.eposta || '?').trim()[0].toLocaleUpperCase('tr');
    }
    function hepsiniCiz() {
      basCiz();
      const acik = veri.talepler.filter((t: any) => t.durum === 'acik').length;
      say('acik', acik); say('teklif', veri.talepler.reduce((a: number, t: any) => a + t.teklifler.length, 0));
      say('favori', JSON.parse(localStorage.getItem('pt_fav') || '[]').length); say('siparis', veri.siparisler.length);
      document.querySelector('[data-rz=talepler]')!.textContent = acik ? String(acik) : '';
      document.querySelector('[data-rz=surec]')!.textContent = veri.siparisler.length ? String(veri.siparisler.length) : '';
      $('hs-uyari').replaceChildren(veri.ben.dogrulandi ? '' : h('p', { class: 'note-a', style: { margin: 0 } }, 'E-posta adresinizi doğrulayın; böylece daha önce bu adresle gönderdiğiniz talepler de burada görünür. ', h('button', { class: 'lnk', type: 'button', onclick: async () => { await dogrulamaGonder(); toast('Doğrulama e-postası gönderildi'); } }, 'Doğrulama e-postası gönder')));
      genelCiz(); talepCiz(); surecCiz(); ayarCiz();
      if (!$('p-favoriler').hidden) favCiz();
    }
    async function yukle() {
      veri = await api('/api/hesap');
      try { localStorage.setItem('pt_hesap_' + uid, JSON.stringify({ t: Date.now(), veri })); } catch { /* */ }
      const yerel: string[] = JSON.parse(localStorage.getItem('pt_fav') || '[]');
      if (veri.favoriler?.length) localStorage.setItem('pt_fav', JSON.stringify([...new Set([...yerel, ...veri.favoriler])]));
      hepsiniCiz();
    }
    (async () => {
      try {
        const u = await kullanici();
        if (!u) { location.href = '/giris/?geri=' + encodeURIComponent(location.pathname + location.search + location.hash); return; }
        uid = u.uid;
        // E-postadaki “Talebimi takip et” bağlantısı: talep bu hesaba eklenir (başka e-postayla gönderilmiş olsa da)
        const bagla = new URLSearchParams(location.search).get('bagla');
        if (bagla) {
          history.replaceState(null, '', location.pathname + location.hash);
          try { const r = await api('/api/hesap/bagla', { kod: bagla }); if (r.yeni) toast('Talebiniz hesabınıza eklendi'); else if (r.baska) toast('Bu talep başka bir hesaba bağlı.'); } catch (e: any) { toast(e.message || 'Talep eklenemedi'); }
        }
        // Son görülen bilgilerle hemen çiz, ardından güncelle (sayfa anında açılır)
        try { const c = JSON.parse(localStorage.getItem('pt_hesap_' + uid) || 'null'); if (c?.veri) { veri = c.veri; hepsiniCiz(); } } catch { /* */ }
        if (!veri) { $('hs-eposta').textContent = u.email || u.phoneNumber || ''; $('hs-ad').textContent = u.displayName ? `Merhaba ${u.displayName.split(/\s+/)[0]}` : 'Hesabım'; }
        ac(location.hash.slice(1) || 'genel');
        oturumAc().then((b) => onayIste(b)).catch(() => {}); // favorileri birleştir, başlıktaki adı güncelle, eksik sözleşme onayını iste (arka planda)
        await yukle();
        if (!location.hash && !veri.talepler.length && veri.siparisler.length) ac('surec');
      } catch (e) { if (!veri) hataGoster($('p-genel'), e); else toast('Bilgiler güncellenemedi; son kaydedilen hali gösteriliyor.'); }
    })();
    window.addEventListener('pt:fav', () => { api('/api/favoriler', { favoriler: JSON.parse(localStorage.getItem('pt_fav') || '[]'), degistir: true }).catch(() => {}); setTimeout(favCiz, 50); });
  </script>
</Base>

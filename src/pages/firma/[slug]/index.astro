---
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import ModelList from '../../../components/ModelList.astro';
import Puanlar from '../../../components/Puanlar.astro';
import Stats from '../../../components/Stats.astro';
import FirmaLogo from '../../../components/FirmaLogo.astro';
import { SITE } from '../../../site.config';
import { firms, models, TIPLER, meta, kisaTl, sirala, istatistik, monogram, tipImg } from '../../../lib/data';
export function getStaticPaths() {
  return firms.map((f) => ({ params: { slug: f.slug }, props: { f } }));
}
const { f } = Astro.props;
const list = sirala(models.filter((m) => m.firma === f.slug));
const s = istatistik(list);
const tipler = f.tipler.map((t) => TIPLER[t]?.ad).filter(Boolean);
const urunler = tipler.length ? tipler.join(', ') : f.urunTipleri.join(', ');
// Başlık: "Karmod Prefabrik Ev Fiyatları", "Asia Prefabrik Ev Fiyatları", "Elbarsco Tiny House Fiyatları" (marka araması + ürün)
// Birden çok tip üreten ya da prefabrik üreten firmada genel terim "Prefabrik Ev" (marka aramaları: "karmod prefabrik")
const anaTipKey = f.tipler.length === 1 ? f.tipler[0] : 'prefabrik';
const urunAd = (TIPLER[anaTipKey]?.baslik || 'Prefabrik Ev Fiyatları').replace(/ Fiyatları$/, '');
const ilk = urunAd.split(' ')[0];
const kk = f.kisaAd.toLocaleLowerCase('tr');
const urunEki = kk.includes(urunAd.toLocaleLowerCase('tr')) ? '' : kk.includes(ilk.toLocaleLowerCase('tr')) ? urunAd.split(' ').slice(1).join(' ') : urunAd;
const sayfaBaslik = `${f.kisaAd}${urunEki ? ' ' + urunEki : ''} Fiyatları ${meta.ay}${list.length ? `: ${list.length} Model` : ''}`;
const desc = `${f.kisaAd}${f.il ? ` (${f.il})` : ''} ${urunler.toLocaleLowerCase('tr')} modelleri ve fiyatları${s.min ? `: ${kisaTl(s.min)}’den başlayan ${list.length} model` : ''}. Fiyata neyin dahil olduğunu görün, diğer firmalarla kıyaslayın, teklif alın.`;
const ld = [{
  '@context': 'https://schema.org', '@type': 'Organization', name: f.kisaAd, legalName: f.ad !== f.kisaAd ? f.ad : undefined,
  url: f.web || undefined, ...(f.il ? { address: { '@type': 'PostalAddress', addressRegion: f.il, addressCountry: 'TR' } } : {}),
}];
const ana = f.tipler[0] || 'prefabrik';
// Firma hakkında ve piyasa bağlamı: ürettiği tiplerde Türkiye geneli fiyatlar, aynı ildeki diğer üreticiler
const tipOzet = f.tipler.filter((t) => TIPLER[t]).map((t) => ({ t, ad: TIPLER[t].ad, slug: TIPLER[t].slug, s: istatistik(models.filter((m) => m.tip === t)) }));
const ayniIl = f.il ? firms.filter((x) => x.il === f.il && x.slug !== f.slug).sort((a, b) => b.modelSayisi - a.modelSayisi).slice(0, 8) : [];
const urunGrup = [...new Set(f.urunTipleri.map((u) => u.trim().toLocaleLowerCase('tr')).filter(Boolean))];
const tipYazi = tipler.length > 1 ? `${tipler.slice(0, -1).join(', ')} ve ${tipler.at(-1)}` : tipler[0] || 'prefabrik yapı';
---
<Base title={sayfaBaslik} description={desc} jsonLd={ld} ogType="profile">
  <div class="wrap">
    <div class="phead" style="min-height:200px">
      <img src={tipImg(ana, 960)} alt="" width="960" height="723" fetchpriority="high" />
      <span class="tm" style="position:absolute;right:12px;top:12px;z-index:2;font-size:.7rem;font-weight:700;background:rgba(255,255,255,.92);color:var(--ink-2);border-radius:999px;padding:3px 9px">Temsili görsel · firmaya ait değildir</span>
      <div class="in" style="display:flex;gap:16px;align-items:flex-end">
        {f.logo ? <FirmaLogo f={f} boyut={64} style="border-radius:16px" /> : <span class="mono" style="width:64px;height:64px;border-radius:18px;font-size:1.3rem;background:#fff;color:var(--ink)">{monogram(f.kisaAd)}</span>}
        <span><h1 style="margin:0 0 4px">{f.kisaAd}</h1><p>{[urunler, f.il].filter(Boolean).join(' · ')}</p></span>
      </div>
    </div>
    <Crumbs items={[{ ad: 'Firmalar', url: '/firmalar/' }, { ad: f.kisaAd }]} />
    <div class="cols">
      <div style="display:flex;flex-direction:column;gap:12px">
        <div data-dogrulama={f.slug} style="display:flex;flex-direction:column;gap:10px">
          <p style="margin:0" data-dg-yok><span class="st-b">Listelenmiş · firma henüz doğrulanmadı</span></p>
          <a class="claim-bar" href={`/firma-kayit/?firma=${f.slug}`} data-dg-yok>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
            <span><b>Bu firma size mi ait?</b> Hemen doğrulayın: fiyat ve fotoğraflarınızı kendiniz güncelleyin, size gelen taleplere teklif verin.</span>
            <span class="btn btn-p btn-s">Firmayı doğrula</span>
          </a>
          <p style="margin:0" data-dg-var hidden><span class="st-b g">✓ Üye firma</span> <span class="small muted">Firmanın belgeleri {SITE.ad} tarafından kontrol edildi, üyeliği aktif.</span></p>
        </div>
        {f.sertifikalar.length > 0 && (
          <>
            <ul class="tags" aria-label="Belgeler">{f.sertifikalar.map((c) => <li class="b">{c}</li>)}</ul>
            <p class="small muted" style="margin:0">Belgeler firmanın sitesindeki beyandır; doğrulamada aslı kontrol edilir.</p>
          </>
        )}
        {!f.sertifikalar.length && f.sertifikaNotu && <p class="small muted" style="margin:0">{f.sertifikaNotu}</p>}
        {list.length > 0 && <Stats s={s} />}
      </div>
      <aside>
        <div class="box dk">
          <a class="btn btn-w btn-block" href={`/teklif-al/?firmalar=${f.slug}&tip=${encodeURIComponent(ana)}`}>Bu firmadan teklif al</a>
          <p class="small" style="margin:10px 0 0">Bilgileriniz yalnızca fiyat vermeyi kabul ederse firmayla paylaşılır.</p>
          {(f.web || f.il) && <p class="small" style="margin:8px 0 0;display:flex;gap:14px;flex-wrap:wrap">{f.web && <a style="color:#fff" href={f.web} rel="nofollow noopener" target="_blank">Firmanın sitesi ↗</a>}{f.il && <a style="color:#fff" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${f.ad || f.kisaAd} ${f.il}`)}`} rel="nofollow noopener" target="_blank">Haritada gör ↗</a>}</p>}
        </div>
      </aside>
    </div>

    <section class="sec" style="padding-top:28px">
      <h2 style="margin-top:0">Modeller ve fiyatlar</h2>
      <div class="grid" data-yeni={f.slug} hidden style="margin-bottom:16px"></div>
      {list.length ? <ModelList list={list} firmaGoster={false} /> : <p class="muted">{f.modelBekliyor ? 'Bu firmanın modelleri ve fiyatları henüz listemize eklenmedi. Teklif isteyerek güncel fiyat alabilirsiniz.' : 'Bu firma sitesinde fiyat yayınlamıyor. Teklif isteyerek güncel fiyat alabilirsiniz.'}</p>}
    </section>

    <section class="sec" style="padding-top:28px">
      <h2 style="margin-top:0">{f.kisaAd} hakkında</h2>
      <p style="max-width:820px">{f.kisaAd}{f.il ? `, ${f.il} merkezli` : ''} bir {tipYazi.toLocaleLowerCase('tr')} üreticisidir.{urunGrup.length ? ` Firmanın kendi sitesinde belirttiği ürün grupları: ${urunGrup.join(', ')}.` : ''} {list.length ? `Sitemizde ${list.length} modeli listeleniyor${s.min ? `; en uygun fiyatlı model ${kisaTl(s.min)}` : ''}.` : 'Güncel model ve fiyat bilgisi için teklif isteyebilir, aynı anda başka firmalardan da fiyat alarak karşılaştırabilirsiniz.'}</p>
      {tipOzet.length > 0 && (
        <>
          <h3>Türkiye genelinde {tipYazi.toLocaleLowerCase('tr')} fiyatları</h3>
          <div class="tbl-wrap"><table>
            <thead><tr><th>Ev tipi</th><th>Listelenen model</th><th>En düşük</th><th>Ortanca fiyat</th><th></th></tr></thead>
            <tbody>{tipOzet.map((x) => <tr><td>{x.ad}</td><td>{x.s.model} model, {x.s.firma} firma</td><td>{x.s.min ? kisaTl(x.s.min) : '-'}</td><td>{x.s.medyan ? kisaTl(x.s.medyan) : '-'}</td><td><a href={`/${x.slug}/`}>Tüm {x.ad.toLocaleLowerCase('tr')} fiyatları</a></td></tr>)}</tbody>
          </table></div>
          <p class="xs muted">Fiyatlar firmaların kendi sitelerinde yayınladığı ilan fiyatlarıdır, {meta.sonKontrolYazi} tarihinde kontrol edildi.</p>
        </>
      )}
      {ayniIl.length > 0 && (
        <>
          <h3>{f.il} ilindeki diğer üreticiler</h3>
          <ul style="display:flex;flex-wrap:wrap;gap:8px 18px;padding:0;list-style:none">{ayniIl.map((x) => <li><a href={`/firma/${x.slug}/`}>{x.kisaAd}</a>{x.modelSayisi ? <span class="muted small"> · {x.modelSayisi} model</span> : null}</li>)}</ul>
        </>
      )}
    </section>

    <section class="sec" style="padding-top:28px"><Puanlar slug={f.slug} /></section>

    <aside class="note-a" data-liste-uyari={f.slug} style="margin-top:28px;display:flex;gap:12px;align-items:flex-start">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex:none;margin-top:2px"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5v.5"/></svg>
      <span><b>Bilgilendirme:</b> {f.kisaAd}, ev arayanlar fiyatları karşılaştırabilsin diye firmanın kendi sitesinde herkese açık yayınladığı bilgilerle listelenmiştir; {SITE.ad} ile bir üyelik ilişkisi yoktur. <b>Firma sahibiyseniz:</b> firma üyeliği başlatılmazsa bu sayfa ay sonunda sitemizden kaldırılır. Bilgilerinizi güncel tutmak ve taleplere fiyat vermek için <a href={`/firma-kayit/?firma=${f.slug}`}>firmanızı sahiplenin</a>.</span>
    </aside>
    <div class="band" style="margin-top:28px" data-dg-yok>
      <div><h2>Bu firma sizin mi?</h2><p>Üye olun; bu sayfaya ve bölgenize gelen müşteri talepleri tüm detaylarıyla panelinize düşsün, fiyat ve fotoğraflarınızı kendiniz güncelleyin. Komisyon yok, aylık {SITE.abonelik} TL.</p><p data-kampanya-yazi hidden style="font-weight:700;margin-top:6px">Açılış kampanyası: ilk 50 firmaya 1 ay ücretsiz üyelik, kart bilgisi istemeden.</p></div>
      <div class="btns"><a class="btn btn-w" href={`/firma-kayit/?firma=${f.slug}`}>Firmamı sahiplen</a></div>
    </div>
  </div>
  <script>
    import { katalog, kampanyaYazilari } from '../../../scripts/katalog';
    kampanyaYazilari();
    const box = document.querySelector<HTMLElement>('[data-yeni]');
    katalog().then((k) => {
      // Üye (ödeme yapan) firmalarda "listelenmiş" uyarısını gizle
      const uyari = document.querySelector<HTMLElement>('[data-liste-uyari]');
      if (uyari && (k as any)['uye:' + uyari.dataset.listeUyari]) {
        // Üyeliği aktif (doğrulanmış) firma: uyarıları ve "bu firma sizin mi" çağrısını gizle, rozeti göster
        uyari.hidden = true;
        document.querySelectorAll<HTMLElement>('[data-dg-yok]').forEach((e) => (e.hidden = true));
        document.querySelectorAll<HTMLElement>('[data-dg-var]').forEach((e) => (e.hidden = false));
      }
      const yeni = Object.values(k).filter((x) => x.yeni && x.firma === box?.dataset.yeni);
      if (!box || !yeni.length) return;
      for (const x of yeni) {
        const a = document.createElement('a'); a.className = 'mcard'; a.href = `/model/?id=${encodeURIComponent(x.id)}`; a.style.textDecoration = 'none'; a.style.color = 'inherit';
        const ph = document.createElement('span'); ph.className = 'ph';
        const g = (x.gorseller || []).find((u) => /^https:\/\//.test(u));
        if (g) { const im = document.createElement('img'); im.src = g; im.alt = ''; im.loading = 'lazy'; ph.append(im); }
        const bd = document.createElement('span'); bd.className = 'bd';
        const fr = document.createElement('span'); fr.className = 'fr'; fr.textContent = 'Yeni eklendi';
        const h = document.createElement('b'); h.textContent = x.ad || '';
        const p = document.createElement('strong'); p.textContent = x.fiyat ? new Intl.NumberFormat('tr-TR').format(x.fiyat) + ' TL' : 'Fiyat için teklif alın';
        bd.append(fr, h, p); a.append(ph, bd); box.append(a);
      }
      box.hidden = false;
    });
  </script>
</Base>

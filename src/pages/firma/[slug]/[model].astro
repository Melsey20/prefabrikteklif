---
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import ModelCard from '../../../components/ModelCard.astro';
import { SITE } from '../../../site.config';
import { models, firmBySlug, TIPLER, meta, fiyatYazi, sayi, tl, benzerler, kalemYazi, modelUrl } from '../../../lib/data';
export function getStaticPaths() {
  return models.map((m) => ({ params: { slug: m.firma, model: m.slug }, props: { m } }));
}
const { m } = Astro.props;
const f = firmBySlug(m.firma)!;
const T = TIPLER[m.tip];
const benzer = benzerler(m);
const kal = (['kdv', 'nakliye', 'montaj', 'zemin'] as const).map((k) => ({ ad: kalemYazi[k], v: m[k] }));
const detay = [m.m2 ? `${sayi(m.m2)} m²` : '', m.oda].filter(Boolean).join(' ');
const title = `${f.kisaAd} ${m.ad}${m.fiyat && m.fiyatTuru === 'model' ? ` Fiyatı ${meta.ay}` : ''}`;
const desc = `${f.kisaAd} ${m.ad}${detay ? ` (${detay})` : ''}: ${fiyatYazi(m)}. Fiyata neyin dahil olduğu, kaynak ve benzer ${T.kisa} modelleriyle kıyas. Ücretsiz teklif alın.`;
const ld = m.fiyat && m.fiyatTuru === 'model' ? [{
  '@context': 'https://schema.org', '@type': 'Product', name: `${f.kisaAd} ${m.ad}`, category: T.ad,
  brand: { '@type': 'Brand', name: f.kisaAd }, url: new URL(modelUrl(m), SITE.url).href,
  description: `${T.ad}${detay ? `, ${detay}` : ''}. ${m.kapsam}`.slice(0, 300),
  offers: { '@type': 'Offer', price: m.fiyat, priceCurrency: 'TRY', availability: 'https://schema.org/InStock', url: m.kaynak,
    seller: { '@type': 'Organization', name: f.kisaAd },
    ...(m.kdv ? { priceSpecification: { '@type': 'PriceSpecification', price: m.fiyat, priceCurrency: 'TRY', valueAddedTaxIncluded: m.kdv === 'dahil' } } : {}) },
}] : [];
---
<Base title={title} description={desc} jsonLd={ld} selbar tip={m.tip} ogType="product">
  <div class="wrap">
    <Crumbs items={[{ ad: T.baslik, url: `/${T.slug}/` }, { ad: f.kisaAd, url: `/firma/${f.slug}/` }, { ad: m.ad }]} />
    <div class="cols">
      <div>
        <h1 style="margin-bottom:6px">{f.kisaAd} {m.ad}</h1>
        <p class="muted">{[T.ad, detay, m.kat === 2 ? 'Dubleks' : m.kat === 1 ? 'Tek kat' : m.katRaw === 'loft' ? 'Loftlu' : ''].filter(Boolean).join(' · ')}</p>
        <p style="margin:0"><strong class="price" style="font-size:2rem;font-weight:800">{fiyatYazi(m)}</strong></p>
        {m.m2Fiyat && <p class="muted">{sayi(m.m2Fiyat)} TL/m²</p>}
        {m.uyari && <p class="warn">{m.uyari}</p>}
        <h2>Fiyata neler dahil?</h2>
        <div class="tbl-wrap">
          <table>
            <tbody>
              {m.teslim && <tr><th>Teslim şekli</th><td>{m.teslim}</td></tr>}
              {kal.map((k) => <tr><th>{k.ad}</th><td>{k.v === 'dahil' ? 'Dahil' : k.v === 'haric' ? 'Hariç' : 'Sayfada belirtilmemiş'}</td></tr>)}
            </tbody>
          </table>
        </div>
        <p class="note" style="margin-top:10px"><strong>Firma sayfasında yazan:</strong> {m.kapsam}</p>
        <p class="small muted">Kaynak: <a href={m.kaynak} rel="nofollow noopener" target="_blank">{new URL(m.kaynak).hostname.replace('www.', '')}</a> · son kontrol {meta.sonKontrolYazi}. Fiyat firma beyanıdır; KDV ve kapsam için teklif alın.</p>
      </div>
      <aside class="sticky-side">
        <div class="box">
          <h2 style="margin-top:0;font-size:1.15rem">Bu model için teklif al</h2>
          <p class="small muted">{f.kisaAd} ve benzer modelleri olan firmalardan 24 saatte teklif al. Ücretsiz.</p>
          <a class="btn btn-o btn-block" href={`/teklif-al/?firmalar=${[f.slug, ...new Set(benzer.map((b) => b.firma))].slice(0, SITE.maksFirma).join(',')}&tip=${encodeURIComponent(m.tip)}${m.oda ? `&oda=${encodeURIComponent(m.oda)}` : ''}${m.m2 ? `&m2=${m.m2}` : ''}`}>Teklif al</a>
          <p class="small" style="margin:12px 0 0"><a href={`/firma/${f.slug}/`}>{f.kisaAd} firmasının tüm modelleri</a></p>
        </div>
      </aside>
    </div>
    {benzer.length > 0 && (
      <section>
        <h2>Benzer {T.kisa} modelleri, diğer firmalar</h2>
        <div class="grid">{benzer.map((b) => <ModelCard m={b} />)}</div>
        <p style="margin-top:14px"><a href={`/${T.slug}/`}>Tüm {T.baslik.toLocaleLowerCase('tr')}</a></p>
      </section>
    )}
  </div>
</Base>

---
import { ik } from '../lib/panelIkon';
import Base from '../layouts/Base.astro';
import { TIPLER, TIP_SIRA } from '../lib/data';
const tipler = TIP_SIRA.map((k) => ({ k, ad: TIPLER[k].ad }));
---
<Base title="Yönetim Paneli" description="PrefabrikTeklif yönetim paneli." noindex>
  <div class="wrap" id="y-yukleniyor" style="padding:60px 0;text-align:center"><div class="spin" aria-hidden="true"></div><p class="muted" style="margin-top:14px">Yönetim paneli açılıyor…</p></div>
  <div class="wrap" id="y-giris" hidden>
    <div class="auth"><h1 style="font-size:1.5rem;margin-top:0">Yönetim paneli</h1><p class="muted" id="y-mesaj">Yönetici hesabıyla giriş yapın.</p><a class="btn btn-p" id="y-giris-btn" href="/giris/?geri=/yonetim/">Giriş yap</a></div>
  </div>
  <div class="app" id="y-app" hidden>
    <aside aria-label="Yönetim bölümleri" id="sekmeler">
      <div class="side-x" style="font-weight:800;padding:4px 12px 16px">Yönetim</div>
      <button type="button" data-sekme="ozet"><Fragment set:html={ik('ozet')} /><span class="pt">Özet</span></button>
      <button type="button" data-sekme="onaylar"><Fragment set:html={ik('onay')} /><span class="pt">Onaylar</span><span class="rz" data-rz="onay"></span></button>
      <button type="button" data-sekme="talepler"><Fragment set:html={ik('talep')} /><span class="pt">Talepler</span></button>
      <button type="button" data-sekme="siparisler"><Fragment set:html={ik('siparis')} /><span class="pt">Siparişler</span><span class="rz" data-rz="siparis"></span></button>
      <button type="button" data-sekme="firmalar"><Fragment set:html={ik('firma')} /><span class="pt">Firmalar</span></button>
      <button type="button" data-sekme="kullanicilar"><Fragment set:html={ik('kullanici')} /><span class="pt">Kullanıcılar</span></button>
      <button type="button" data-sekme="tanitim"><Fragment set:html={ik('davet')} /><span class="pt">Firma daveti</span></button>
      <button type="button" data-sekme="geri-bildirim"><Fragment set:html={ik('mesaj')} /><span class="pt">Geri bildirim</span><span class="rz" data-rz="gb"></span></button>
      <button type="button" data-sekme="bannerlar"><Fragment set:html={ik('reklam')} /><span class="pt">Reklam alanları</span><span class="rz" data-rz="reklam"></span></button>
      <button type="button" data-sekme="fiyat"><Fragment set:html={ik('fiyat')} /><span class="pt">Fiyat kontrolü</span></button>
      <a class="ln side-x" href="/" style="margin-top:auto">Siteye dön</a>
      <button type="button" class="cikis-btn" data-cikis><svg class="pik" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3"/><path d="M10 17l-5-5 5-5M5 12h11"/></svg><span class="pt">Çıkış yap</span></button>
    </aside>
    <main>
      <div id="eposta-uyari" class="box" hidden style="border-color:#c0392b;background:#fdecea;margin-bottom:16px"></div>
      <section data-panel="ozet"><div class="ph-h"><h1>Özet</h1><button class="btn btn-g btn-s" type="button" id="ist-hesapla" title="Sayaçları talep geçmişinden yeniden hesaplar">Sayıları yeniden hesapla</button></div><div id="p-ozet"></div></section>
      <section data-panel="kullanicilar" hidden><div class="ph-h"><div><h1>Kullanıcılar</h1><p class="small muted" style="margin:4px 0 0">Hesap açan kullanıcılar ve hesabı olmadan talep gönderenler. Talep ve gelen teklif sayıları test talepleri hariçtir.</p></div></div><div id="p-kullanicilar"></div><h2 style="font-size:1.15rem;margin:26px 0 10px">Sözleşme onay kayıtları (son 100)</h2><p class="small muted" style="margin:0 0 10px">Her talep, kayıt, firma başvurusu ve abonelikte hangi metnin hangi sürümünün, ne zaman, hangi tarayıcıdan onaylandığı saklanır. Uyuşmazlıkta ispat için kullanılır.</p><div id="p-onaykayit"></div></section>
      <section data-panel="tanitim" hidden><div class="ph-h"><div><h1>Firmalara tanıtım e-postası</h1><p class="small muted" style="margin:4px 0 0">Açıkken her gün saat 10.00’da sıradaki firmalara gönderilir. Kayıtlı firmalara, ret bağlantısına tıklayanlara ve son 30 günde e-posta alanlara gitmez; bir adrese en fazla 2 kez gider.</p></div></div><div id="p-tanitim"></div></section>
      <section data-panel="onaylar" hidden><div class="ph-h"><h1>Onay bekleyenler</h1></div><div id="p-onaylar" class="list"></div></section>
      <section data-panel="talepler" hidden><div class="ph-h"><h1>Teklif talepleri</h1><a class="btn btn-g btn-s" href="/teklif-al/?test=1&tip=prefabrik&il=Malatya" title="Yalnızca yönetici e-postasıyla kayıtlı test firmalarına gider">Test talebi gönder</a></div><div id="p-talepler"></div></section>
      <section data-panel="siparisler" hidden><div class="ph-h"><h1>Yönettiğimiz siparişler</h1></div><div id="p-kanban" class="kanban" style="margin-bottom:18px"></div><div id="p-siparisler" class="list"></div></section>
      <section data-panel="firmalar" hidden><div class="ph-h"><div><h1>Kayıtlı firmalar</h1><p class="small muted" style="margin:4px 0 0">Talepler yalnızca aktif ve e-postası olan firmalara gider. Panel e-postaları firma paneline giriş yapabilir.</p></div><button class="btn btn-p btn-s" type="button" id="firma-ekle">+ Firma hesabı aç</button></div><div id="p-firmalar"></div></section>
      <section data-panel="geri-bildirim" hidden><div class="ph-h"><h1>Firma geri bildirimleri</h1></div><div id="p-gb" class="list"></div><h2 style="font-size:1.15rem;margin:26px 0 10px">Siteden gelen mesajlar (Bize yazın)</h2><div id="p-iletisim" class="list"></div></section>
      <section data-panel="bannerlar" hidden><div class="ph-h"><div><h1>Reklam alanları</h1><p class="small muted" style="margin:4px 0 0">Ana, yan ve ara banner alanlarında en fazla 6, öne çıkan listelemede en fazla 10 aktif reklam olabilir. Hepsi “Reklam” etiketiyle gösterilir.</p></div><button class="btn btn-p btn-s" type="button" id="banner-ekle">+ Reklam ekle</button></div><div id="p-doluluk" class="stats" style="margin-bottom:14px"></div><h2 style="font-size:1.1rem;margin:0 0 10px">Reklam talepleri</h2><div id="p-reklamt" class="list" style="margin-bottom:22px"></div><h2 style="font-size:1.1rem;margin:0 0 10px">Yayındaki ve pasif reklamlar</h2><div id="p-bannerlar" class="list"></div></section>
      <section data-panel="fiyat" hidden><div class="ph-h"><div><h1>Aylık fiyat kontrolü</h1><p class="small muted" style="margin:4px 0 0">Her ayın 1’i saat 17.00’de firma sayfaları otomatik taranır; değişmiş görünen fiyatlar “Onaylar” sekmesine düşer.</p></div></div><div id="p-fiyat"></div></section>
    </main>
  </div>
  <script define:vars={{ TIPLER_L: tipler }}>window.__TIPLER = TIPLER_L;</script>
  <script>
    import { kullanici, api, oturumAc, ApiHata, token, cikis } from '../scripts/fb';
    const EVRAK: Record<string, string> = { 'vergi-levhasi': 'Vergi levhası', faaliyet: 'Faaliyet belgesi', 'sicil-gazetesi': 'Ticaret Sicil Gazetesi', 'imza-sirkuleri': 'İmza sirküleri', diger: 'Diğer belge' };
    // Evrakı yetkili istekle indirip yeni sekmede açar (bağlantı paylaşılamaz)
    async function belgeAc(id: string) {
      const w = window.open('', '_blank');
      try {
        const r = await fetch('/api/yonetim/belge?id=' + encodeURIComponent(id), { headers: { Authorization: 'Bearer ' + (await token()) } });
        if (!r.ok) throw new Error((await r.json().catch(() => ({}))).hata || 'Belge açılamadı.');
        const url = URL.createObjectURL(await r.blob());
        if (w) w.location.href = url;
        else { const a = document.createElement('a'); a.href = url; a.download = (r.headers.get('Content-Disposition')?.match(/filename\*?=(?:UTF-8'')?"?([^";]+)/)?.[1] && decodeURIComponent(r.headers.get('Content-Disposition')!.match(/filename\*?=(?:UTF-8'')?"?([^";]+)/)![1])) || 'belge'; document.body.append(a); a.click(); a.remove(); toast('Tarayıcı yeni pencereyi engelledi; belge indirildi.'); }
      } catch (e: any) { w?.close(); toast(e.message); }
    }
    import { h, tl, tarih, kalan, toast, modal, alan, sekmeler } from '../scripts/ui';
    const TIPLER: { k: string; ad: string }[] = (window as any).__TIPLER;
    const TIP = Object.fromEntries(TIPLER.map((t) => [t.k, t.ad]));
    const $ = (id: string) => document.getElementById(id)!;
    let V: any;
    const inp = (name: string, at: Record<string, any> = {}) => h('input', { name, ...at }) as HTMLInputElement;
    const yap = async (yol: string, body: any, msg = 'Kaydedildi') => { try { await api(yol, body); toast(msg); await yukle(); } catch (e: any) { toast(e.message); } };
    const satir = (k: string, v: any) => (v ? h('div', { class: 'small' }, h('b', {}, k + ': '), String(v)) : null);

    function onaylarCiz() {
      const els: Node[] = [];
      for (const d of V.degisiklikler) {
        const fiyatInp = inp('fiyat', { type: 'number', min: 1000, value: d.veri?.fiyat ?? '', style: { maxWidth: '180px' } });
        const not = inp('not', { type: 'text', placeholder: 'Firmaya not (isteğe bağlı)', maxlength: 500 });
        const baslik = d.tur === 'fiyat-kontrol' ? 'Aylık kontrol: fiyat değişmiş olabilir' : d.tur === 'yeni' ? 'Yeni ürün' : d.tur === 'kaldir' ? 'Yayından kaldırma' : 'Ürün güncelleme';
        els.push(h('article', { class: 'item' },
          h('div', { class: 'row' }, h('b', {}, `${baslik} · ${d.firmaAd}`), h('span', { class: 'st-b a' }, tarih(d.zaman))),
          satir('Model', d.veri?.ad || d.model?.ad || d.modelId),
          d.model ? satir('Mevcut fiyat', tl(d.model.fiyat)) : null,
          d.tur === 'fiyat-kontrol' ? h('div', { class: 'small' }, h('b', {}, 'Kayıtlı: '), tl(d.veri.eski), ' · ', h('b', {}, 'Sayfada bulunan: '), d.veri.adaylar?.length ? d.veri.adaylar.map(tl).join(', ') : 'fiyat bulunamadı', ' · ', h('a', { href: d.veri.kaynak, target: '_blank', rel: 'noopener' }, 'sayfayı aç ↗')) : null,
          d.tur !== 'fiyat-kontrol' && d.veri?.fiyat ? satir('Yeni fiyat', tl(d.veri.fiyat) + (d.veri.kdv === 'haric' ? ' + KDV' : d.veri.kdv === 'dahil' ? ' (KDV dahil)' : '')) : null,
          satir('Tip / alan', [TIP[d.veri?.tip], d.veri?.m2 ? `${d.veri.m2} m²` : '', d.veri?.oda].filter(Boolean).join(' · ')),
          satir('Teslim', d.veri?.teslim), satir('Kapsam', d.veri?.kapsam), satir('Firmanın notu', d.veri?.not),
          d.veri?.gorseller?.length ? h('div', { style: { display: 'flex', gap: '6px', flexWrap: 'wrap' } }, ...d.veri.gorseller.map((u: string) => h('a', { href: u, target: '_blank', rel: 'noopener' }, h('img', { src: u, alt: '', loading: 'lazy', style: { width: '96px', height: '72px', objectFit: 'cover', borderRadius: '8px' } })))) : null,
          d.tur !== 'kaldir' ? h('label', { class: 'small', style: { display: 'flex', alignItems: 'center', gap: '8px', fontWeight: 700 } }, 'Yayınlanacak fiyat (TL)', fiyatInp) : null,
          not,
          h('div', { style: { display: 'flex', gap: '8px' } },
            h('button', { class: 'btn btn-p btn-s', type: 'button', onclick: () => yap('/api/yonetim/degisiklik', { id: d.id, karar: 'onay', fiyat: fiyatInp.value ? Number(fiyatInp.value) : null, not: not.value }, 'Onaylandı, yayında') }, 'Onayla ve yayınla'),
            h('button', { class: 'btn btn-g btn-s', type: 'button', onclick: () => yap('/api/yonetim/degisiklik', { id: d.id, karar: 'red', not: not.value }, 'Reddedildi') }, d.tur === 'fiyat-kontrol' ? 'Değişiklik yok' : 'Reddet'))));
      }
      for (const b of V.basvurular) {
        const odeme = inp('odeme', { type: 'url', placeholder: 'https://… (iyzico / PayTR / banka ödeme linki)', style: { maxWidth: '420px' } });
        const kurucuChk = inp('kurucu', { type: 'checkbox', checked: true }) as HTMLInputElement;
        const slug = h('select', { style: { maxWidth: '320px' } }, h('option', { value: '' }, 'Yeni firma (koddan otomatik)'), ...V.statikFirmalar.map((f: any) => h('option', { value: f.slug, selected: f.slug === b.mevcut }, f.ad))) as HTMLSelectElement;
        els.push(h('article', { class: 'item' },
          h('div', { class: 'row' }, h('b', {}, `Firma başvurusu · ${b.marka || b.unvan}`), h('span', { class: 'st-b a' }, tarih(b.zaman))),
          satir('Unvan', b.unvan), satir('Vergi', [b.vergiDairesi, b.vergiNo].filter(Boolean).join(' · ')), satir('Yetkili', `${b.yetkili}${b.yetkiliUnvan ? ` (${b.yetkiliUnvan})` : ''} · ${b.telefon} · ${b.eposta}`), satir('Adres', [b.adres, b.merkezIl].filter(Boolean).join(' · ')), satir('Web', b.web),
          (b.evrak || []).length ? h('div', { style: { display: 'flex', gap: '8px', flexWrap: 'wrap', alignItems: 'center' } }, h('b', { class: 'small' }, 'Evrak:'), ...(b.evrak || []).map((e: any) => h('button', { class: 'btn btn-g btn-s', type: 'button', onclick: () => belgeAc(e.id) }, `${EVRAK[e.tur] || e.tur} · ${(e.boyut / 1048576).toFixed(1)} MB`))) : satir('Evrak', 'Yüklenmemiş (eski başvuru)'),
          satir('Tipler', (b.tipler || []).map((t: string) => TIP[t]).join(', ')), satir('İller', b.iller), satir('Belgeler', b.belgeler), satir('Referanslar', b.referanslar), satir('Not', b.not),
          (b.reklam || []).length ? h('p', { class: 'note-a', style: { margin: 0 } }, h('b', {}, 'Öne çıkma isteği: '), (b.reklam || []).map((k: string) => `${V.reklamPaketleri?.[k]?.ad || k} (${(V.reklamPaketleri?.[k]?.fiyat || 0).toLocaleString('tr-TR')} TL/ay)`).join(', '), '. Onaylayınca Reklam talepleri bölümüne “bekliyor” olarak düşer.') : null,
          satir('Üyelik', b.sozlesme ? `Aylık ${b.sozlesme.abonelikTl} TL ve sözleşme onaylandı (${tarih(b.sozlesme.onayZamani)})` : 'Eski başvuru: sözleşme onayı yok'),
          h('label', { class: 'small', style: { display: 'flex', flexDirection: 'column', gap: '4px', fontWeight: 700 } }, 'Listedeki firma kaydı', slug),
          V.kurucuKalan > 0 ? h('label', { class: 'chk' }, kurucuChk, ` Açılış kampanyası: 1 ay ücretsiz aç, hemen teklif verebilir (kalan: ${V.kurucuKalan})`) : h('p', { class: 'xs muted', style: { margin: 0 } }, 'Açılış kampanyası kontenjanı (50 firma) doldu.'),
          h('label', { class: 'small', style: { display: 'flex', flexDirection: 'column', gap: '4px', fontWeight: 700 } }, `${V.abonelik} TL aylık üyelik ödeme bağlantısı (kampanyasız onayda e-postayla gider; kampanyalı onayda ikinci ay için saklanır)`, odeme),
          h('div', { style: { display: 'flex', gap: '8px' } },
            h('button', { class: 'btn btn-p btn-s', type: 'button', onclick: () => yap('/api/yonetim/basvuru', { id: b.id, karar: 'onay', slug: slug.value, odemeLinki: odeme.value.trim(), kurucu: kurucuChk.checked }, kurucuChk.checked && V.kurucuKalan > 0 ? 'Firma hesabı açıldı: 1 ay ücretsiz üyelik' : 'Firma hesabı açıldı, ödeme bağlantısı gönderildi') }, 'Onayla, hesabı aç'),
            h('button', { class: 'btn btn-g btn-s', type: 'button', onclick: () => yap('/api/yonetim/basvuru', { id: b.id, karar: 'red' }, 'Reddedildi') }, 'Reddet'))));
      }
      for (const y of V.yorumlar) {
        els.push(h('article', { class: 'item' },
          h('div', { class: 'row' }, h('b', {}, `Yorum · ${y.firmaAd} · ${y.puan}/5`), h('span', { class: 'st-b a' }, tarih(y.zaman))),
          h('p', { style: { margin: 0 } }, y.metin), satir('Yazan', [y.adGoster, y.eposta].filter(Boolean).join(' · ')), satir('Satın aldı mı?', y.satinAldi === false ? 'Hayır (görüşme / teklif)' : 'Evet'), satir('Belge notu', y.belgeNotu), satir('Aşama', y.asama),
          h('div', { style: { display: 'flex', gap: '8px', flexWrap: 'wrap' } },
            h('button', { class: 'btn btn-p btn-s', type: 'button', onclick: () => yap('/api/yonetim/yorum', { id: y.id, karar: 'onay' }, 'Yorum yayında') }, 'Yayınla'),
            y.satinAldi !== false ? h('button', { class: 'btn btn-g btn-s', type: 'button', onclick: () => yap('/api/yonetim/yorum', { id: y.id, karar: 'onay', belge: true }, 'Yorum “belgeyle doğrulandı” olarak yayında') }, 'Belgeyi gördüm, doğrulanmış yayınla') : null,
            h('button', { class: 'btn btn-g btn-s', type: 'button', onclick: () => yap('/api/yonetim/yorum', { id: y.id, karar: 'red' }, 'Reddedildi') }, 'Reddet'))));
      }
      $('p-onaylar').replaceChildren(...(els.length ? els : [h('div', { class: 'empty' }, 'Onay bekleyen bir şey yok.')]));
    }
    function taleplerCiz() {
      if (!V.talepler.length) { $('p-talepler').replaceChildren(h('div', { class: 'empty' }, 'Henüz talep yok.')); return; }
      $('p-talepler').replaceChildren(h('div', { class: 'list' }, ...V.talepler.map((t: any) => {
        const firma = h('select', {}, h('option', { value: '' }, 'Firma seçin'), ...V.statikFirmalar.map((f: any) => h('option', { value: f.slug }, f.ad))) as HTMLSelectElement;
        const ep = inp('eposta', { type: 'email', placeholder: 'firma@ornek.com' });
        const acik = t.durum === 'acik';
        return h('article', { class: 'item' },
          h('div', { class: 'row' }, h('b', {}, [t.test ? 'TEST' : '', t.mod === 'surec' ? 'SÜREÇ' : '', TIP[t.tip], t.oda, t.m2 ? `${t.m2} m²` : '', [t.il, t.ilce].filter(Boolean).join(' / ')].filter(Boolean).join(' · ')), h('span', { class: 'st-b ' + (acik ? 'a' : 'g') }, t.mod === 'surec' ? 'Süreç yönetimi' : acik ? kalan(t.sonTarih) : 'Özet gönderildi')),
          h('span', { class: 'small' }, `${t.ad} · `, h('a', { href: 'tel:' + t.telefon }, t.telefon), ' · ', h('a', { href: 'mailto:' + t.eposta }, t.eposta)),
          h('span', { class: 'xs muted' }, `${tarih(t.olusturma)} · ${t.davetler?.length || 0} firmaya iletildi · ${t.teklifSayisi || 0} teklif` + (t.davetler?.length ? ' · ' + t.davetler.map((d: any) => `${d.firma} (${d.durum})`).join(', ') : '')),
          t.not ? h('span', { class: 'small muted' }, '“' + t.not + '”') : null,
          acik && t.mod !== 'surec' ? h('details', {}, h('summary', { class: 'small', style: { cursor: 'pointer', fontWeight: 800, color: 'var(--green)' } }, 'Kayıtlı olmayan bir firmaya e-postayla ilet'),
            h('form', { class: 'form', style: { gap: '8px', marginTop: '8px' }, onsubmit: (e: Event) => { e.preventDefault(); yap('/api/yonetim/talep-ilet', { talep: t.id, firma: firma.value, eposta: ep.value }, 'Firmaya iletildi'); } }, h('div', { class: 'two' }, firma, ep), h('button', { class: 'btn btn-p btn-s', type: 'submit', style: { alignSelf: 'flex-start' } }, 'İlet (müşteri bilgisi gizli)'))) : null);
      })));
    }
    function siparislerCiz() {
      $('p-kanban').replaceChildren(...V.asamalar.map((a: string, i: number) => h('div', {}, h('h3', {}, a), ...V.siparisler.filter((s: any) => s.asama === i).map((s: any) => h('a', { class: 'k', href: '#s-' + s.id, style: { textDecoration: 'none', color: 'inherit' } }, h('b', {}, s.ad), h('span', {}, [TIP[s.tip], s.il].filter(Boolean).join(' · ')), s.firmaAd ? h('span', { class: 'muted' }, s.firmaAd) : null)))));
      if (!V.siparisler.length) { $('p-siparisler').replaceChildren(h('div', { class: 'empty' }, 'Aktif sipariş yok. Kullanıcılar “Süreci siz yönetin” dediğinde burada görünür.')); return; }
      $('p-siparisler').replaceChildren(...V.siparisler.map((s: any) => {
        const asama = h('select', {}, ...V.asamalar.map((a: string, i: number) => h('option', { value: i, selected: i === s.asama }, `${i + 1}. ${a}`))) as HTMLSelectElement;
        const firma = h('select', {}, h('option', { value: '' }, 'Firma seçilmedi'), ...V.statikFirmalar.map((f: any) => h('option', { value: f.slug, selected: f.slug === s.firma }, f.ad))) as HTMLSelectElement;
        const not = h('textarea', { rows: 2, placeholder: 'Bu aşama için müşteriye görünen not (ör: Fabrikada üretime başlandı)', maxlength: 1500 }) as HTMLTextAreaElement;
        const bAd = inp('belgeAd', { type: 'text', placeholder: 'Belge adı (ör: Sözleşme)' }); const bUrl = inp('belgeUrl', { type: 'url', placeholder: 'https:// (Drive vb. paylaşım bağlantısı)' });
